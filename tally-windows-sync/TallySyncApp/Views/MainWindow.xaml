<Window x:Class="TallySyncApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TallyLink — Desktop Connector" 
        Height="700" Width="1000"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <!-- Brand Icon -->
                        <Border Width="32" Height="32" Background="{StaticResource PrimaryBrush}" 
                                CornerRadius="8" Margin="0,0,12,0">
                            <TextBlock Text="⚡" FontSize="16" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="TallyLink" 
                                   FontSize="24" FontWeight="Bold" 
                                   Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="TopCompanyText" 
                                   Text="" 
                                   FontSize="16" FontWeight="Medium" 
                                   Foreground="{StaticResource PrimaryBrush}"
                                   Margin="12,0,0,2"
                                   VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <TextBlock Text="Sync your Tally ERP data to cloud in real-time" 
                               FontSize="13" 
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="44,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Status Badge -->
                    <Border x:Name="StatusBadge" 
                            Background="{StaticResource OnlineBrush}" 
                            CornerRadius="16" 
                            Padding="14,7" 
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" 
                                     Fill="White" Margin="0,0,8,0"/>
                            <TextBlock x:Name="StatusText" Text="Ready" 
                                       Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- Logout Button -->
                    <Button Content="Sign Out" 
                            Style="{StaticResource SecondaryButton}"
                            Padding="12,6" FontSize="12"
                            Click="LogoutButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Connection Status Cards ===== -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Tally Status -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="28" Height="28" Background="#DBEAFE" CornerRadius="6" Margin="0,0,10,0">
                            <TextBlock Text="📊" FontSize="14" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Tally ERP" FontSize="14" FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Ellipse x:Name="TallyStatusDot" Width="10" Height="10" 
                                 Fill="{StaticResource WarningBrush}" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TallyStatusText" Text="Checking..." 
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                    </StackPanel>
                    <TextBlock x:Name="TallyEndpoint" Text="localhost:9000" 
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Cloud Status -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="28" Height="28" Background="#D1FAE5" CornerRadius="6" Margin="0,0,10,0">
                            <TextBlock Text="☁️" FontSize="14" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Cloud API" FontSize="14" FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Ellipse x:Name="ApiStatusDot" Width="10" Height="10" 
                                 Fill="{StaticResource WarningBrush}" Margin="0,0,8,0"/>
                        <TextBlock x:Name="ApiStatusText" Text="Checking..." 
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                    </StackPanel>
                    <TextBlock x:Name="ApiEndpoint" Text="Supabase Direct" 
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Queue Status -->
            <Border Grid.Column="4" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="28" Height="28" Background="#FEF3C7" CornerRadius="6" Margin="0,0,10,0">
                            <TextBlock Text="📦" FontSize="14" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Sync Queue" FontSize="14" FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock x:Name="QueueCount" Text="0" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Text=" items synced" VerticalAlignment="Bottom" Margin="5,0,0,3"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                    </StackPanel>
                    <TextBlock x:Name="LastSyncText" Text="Never synced" 
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Main Content ===== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Sync Controls -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Sync Controls" 
                               FontSize="16" FontWeight="SemiBold" 
                               Foreground="{StaticResource TextBrush}"
                               Margin="0,0,0,18"/>

                    <!-- Company Selection & Options -->
                    <StackPanel Grid.Row="1">
                        <!-- Company -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Company" Foreground="{StaticResource TextSecondaryBrush}" 
                                       FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                            <Button x:Name="RefreshCompaniesButton" Content="↻ Refresh" 
                                    Background="Transparent" BorderThickness="0" 
                                    Foreground="{StaticResource PrimaryBrush}" 
                                    FontSize="11" FontWeight="Medium" 
                                    Margin="10,0,0,0" Cursor="Hand"
                                    Click="RefreshCompaniesButton_Click"/>
                        </StackPanel>
                        <ComboBox x:Name="CompanyComboBox" 
                                  Height="42" 
                                  FontSize="14"
                                  Padding="12,8"
                                  Background="{StaticResource SurfaceLightBrush}"
                                  Foreground="{StaticResource TextBrush}"
                                  BorderBrush="{StaticResource BorderBrush}"
                                  BorderThickness="1">
                            <ComboBoxItem Content="Loading companies..." IsSelected="True"/>
                        </ComboBox>

                        <!-- Sync Interval -->
                        <TextBlock Text="Sync Interval" Foreground="{StaticResource TextSecondaryBrush}" 
                                   FontSize="12" FontWeight="Medium" Margin="0,18,0,6"/>
                        <ComboBox x:Name="IntervalComboBox" 
                                  Height="42" 
                                  FontSize="14"
                                  Padding="12,8"
                                  Background="{StaticResource SurfaceLightBrush}"
                                  Foreground="{StaticResource TextBrush}"
                                  BorderBrush="{StaticResource BorderBrush}"
                                  BorderThickness="1">
                            <ComboBoxItem Content="Every 1 minute"/>
                            <ComboBoxItem Content="Every 5 minutes" IsSelected="True"/>
                            <ComboBoxItem Content="Every 15 minutes"/>
                            <ComboBoxItem Content="Every 30 minutes"/>
                            <ComboBoxItem Content="Manual only"/>
                        </ComboBox>

                        <!-- Force Reset -->
                        <CheckBox x:Name="ForceResetCheckBox" 
                                  Content="Force Full Resync (Fix ID Issues)" 
                                  Margin="0,16,0,0"
                                  FontSize="12"
                                  Foreground="{StaticResource ErrorBrush}"/>

                        <!-- Progress -->
                        <TextBlock Text="Sync Progress" Foreground="{StaticResource TextSecondaryBrush}" 
                                   FontSize="12" FontWeight="Medium" Margin="0,20,0,6"/>
                        <ProgressBar x:Name="SyncProgressBar" 
                                     Height="6" 
                                     Value="0"
                                     Background="{StaticResource SurfaceLightBrush}"
                                     Foreground="{StaticResource PrimaryBrush}"
                                     BorderThickness="0"/>
                        <TextBlock x:Name="SyncProgressText" 
                                   Text="Ready to sync"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12" Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,18,0,0">
                        <Button x:Name="SyncNowButton" 
                                Content="⟳  Sync Now" 
                                Style="{StaticResource PrimaryButton}"
                                Click="SyncNowButton_Click"
                                Margin="0,0,10,0"/>
                        <Button x:Name="StartAutoSyncButton" 
                                Content="▶  Auto Sync" 
                                Style="{StaticResource SecondaryButton}"
                                Click="StartAutoSyncButton_Click"
                                Margin="0,0,10,0"/>
                        <Button x:Name="StopAutoSyncButton" 
                                Content="■  Stop" 
                                Style="{StaticResource DangerButton}"
                                Click="StopAutoSyncButton_Click"
                                IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Logs & Errors ===== -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <TabControl Background="Transparent" BorderThickness="0">
                    <!-- Logs Tab -->
                    <TabItem Header="📋 Activity Log">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <Button Content="Clear" Background="Transparent" 
                                    Foreground="{StaticResource TextMutedBrush}"
                                    BorderThickness="0" FontSize="11" 
                                    HorizontalAlignment="Right" Margin="0,4,4,4"
                                    Cursor="Hand"
                                    Click="ClearLogButton_Click"/>

                            <ListBox x:Name="ActivityLogList" Grid.Row="1" 
                                     Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" Margin="0,2" CornerRadius="6" 
                                                Background="#F7F8FA" BorderBrush="#E5E7EB" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" 
                                                           FontSize="12" Foreground="#374151"/>
                                                <TextBlock Text="{Binding Timestamp}" FontSize="10" 
                                                           Foreground="#9CA3AF" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>

                    <!-- Errors Tab -->
                    <TabItem Header="⚠️ Errors">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Button Content="Clear" Background="Transparent" 
                                    Foreground="{StaticResource TextMutedBrush}"
                                    BorderThickness="0" FontSize="11" 
                                    HorizontalAlignment="Right" Margin="0,4,4,4"
                                    Cursor="Hand"
                                    Click="ClearErrorsButton_Click"/>

                            <ListBox x:Name="ErrorLogList" Grid.Row="1" 
                                     Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" Margin="0,2" CornerRadius="6" 
                                                Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" 
                                                           FontSize="12" Foreground="#991B1B" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Details}" TextWrapping="Wrap" 
                                                           FontSize="11" Foreground="#B91C1C" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding Timestamp}" FontSize="10" 
                                                           Foreground="#EF4444" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- ===== Footer ===== -->
        <Border Grid.Row="3" Margin="0,16,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11"
                               VerticalAlignment="Center">
                        <Run Text="© 2026 Shaurya Tech Sol"/>
                        <Run Text="  •  "/>
                        <Run x:Name="AppVersionText" Text="v2.0.1"/>
                    </TextBlock>
                    <Button x:Name="UpdateBtn" 
                            Content="✨ Update Available" 
                            Visibility="Collapsed"
                            Background="#16A34A" Foreground="White" 
                            BorderThickness="0" Padding="8,2" Margin="12,0,0,0"
                            FontSize="10" FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="UpdateBtn_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
                <TextBlock HorizontalAlignment="Right">
                    <Hyperlink x:Name="SettingsLink" 
                               Foreground="{StaticResource PrimaryBrush}"
                               TextDecorations="None"
                               Click="SettingsLink_Click">
                        ⚙️ Settings
                    </Hyperlink>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
