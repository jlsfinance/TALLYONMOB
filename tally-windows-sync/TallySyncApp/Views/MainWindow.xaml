<Window x:Class="TallySyncApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Tally Sync App - LiveKeeping" 
        Height="700" Width="1000"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock Text="Tally Sync App" 
                                   FontSize="28" FontWeight="Bold" 
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock x:Name="TopCompanyText" 
                                   Text="(Selected Company)" 
                                   FontSize="18" FontWeight="SemiBold" 
                                   Foreground="{StaticResource PrimaryBrush}"
                                   Margin="15,0,0,5"
                                   VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <TextBlock Text="Sync your Tally ERP data to cloud in real-time" 
                               FontSize="14" 
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Status Indicator -->
                    <Border x:Name="StatusBadge" 
                            Background="#10B981" 
                            CornerRadius="15" 
                            Padding="15,8" 
                            Margin="0,0,15,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="White" Margin="0,0,8,0"/>
                            <TextBlock x:Name="StatusText" Text="Ready" Foreground="White" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Connection Status Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Tally Status -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="📊 Tally ERP" FontSize="16" FontWeight="SemiBold" 
                               Foreground="{StaticResource TextBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Ellipse x:Name="TallyStatusDot" Width="12" Height="12" 
                                 Fill="{StaticResource WarningBrush}" Margin="0,0,10,0"/>
                        <TextBlock x:Name="TallyStatusText" Text="Checking..." 
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <TextBlock x:Name="TallyEndpoint" Text="localhost:9000" 
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- API Status -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="☁️ Cloud API" FontSize="16" FontWeight="SemiBold" 
                               Foreground="{StaticResource TextBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Ellipse x:Name="ApiStatusDot" Width="12" Height="12" 
                                 Fill="{StaticResource WarningBrush}" Margin="0,0,10,0"/>
                        <TextBlock x:Name="ApiStatusText" Text="Checking..." 
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <TextBlock x:Name="ApiEndpoint" Text="http://localhost:5000" 
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Queue Status -->
            <Border Grid.Column="4" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="📦 Sync Queue" FontSize="16" FontWeight="SemiBold" 
                               Foreground="{StaticResource TextBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock x:Name="QueueCount" Text="0" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Text=" pending items" VerticalAlignment="Bottom" Margin="5,0,0,4"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <TextBlock x:Name="LastSyncText" Text="Never synced" 
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Content Area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- Sync Progress / Controls -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Sync Controls" 
                               FontSize="18" FontWeight="SemiBold" 
                               Foreground="{StaticResource TextBrush}"
                               Margin="0,0,0,20"/>

                    <!-- Company Selection -->
                    <StackPanel Grid.Row="1">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="Company" Foreground="{StaticResource TextSecondaryBrush}" 
                                       FontSize="12" VerticalAlignment="Center"/>
                            <Button x:Name="RefreshCompaniesButton" Content="🔄 Refresh" 
                                    Background="Transparent" BorderThickness="0" 
                                    Foreground="{StaticResource PrimaryBrush}" 
                                    FontSize="11" Margin="10,0,0,0" Cursor="Hand"
                                    Click="RefreshCompaniesButton_Click"/>
                        </StackPanel>
                        <ComboBox x:Name="CompanyComboBox" 
                                  Height="40" 
                                  FontSize="14"
                                  Padding="10,8"
                                  Background="{StaticResource SurfaceLightBrush}"
                                  Foreground="{StaticResource TextBrush}"
                                  BorderThickness="0">
                            <ComboBoxItem Content="Loading companies..." IsSelected="True"/>
                        </ComboBox>

                        <!-- Sync Options -->
                        <TextBlock Text="Sync Interval" Foreground="{StaticResource TextSecondaryBrush}" 
                                   FontSize="12" Margin="0,20,0,5"/>
                        <ComboBox x:Name="IntervalComboBox" 
                                  Height="40" 
                                  FontSize="14"
                                  Padding="10,8"
                                  Background="{StaticResource SurfaceLightBrush}"
                                  Foreground="{StaticResource TextBrush}"
                                  BorderThickness="0">
                            <ComboBoxItem Content="Every 1 minute"/>
                            <ComboBoxItem Content="Every 5 minutes" IsSelected="True"/>
                            <ComboBoxItem Content="Every 15 minutes"/>
                            <ComboBoxItem Content="Every 30 minutes"/>
                            <ComboBoxItem Content="Manual only"/>
                        </ComboBox>

                        <!-- Force Reset Checkbox -->
                        <CheckBox x:Name="ForceResetCheckBox" 
                                  Content="Force Full Resync (Fix ID Issues)" 
                                  Margin="0,15,0,0"
                                  FontSize="12"
                                  Foreground="#EF4444"/>

                        <!-- Progress -->
                        <TextBlock Text="Sync Progress" Foreground="{StaticResource TextSecondaryBrush}" 
                                   FontSize="12" Margin="0,20,0,5"/>
                        <ProgressBar x:Name="SyncProgressBar" 
                                     Height="8" 
                                     Value="0"
                                     Background="{StaticResource SurfaceLightBrush}"
                                     Foreground="{StaticResource PrimaryBrush}"
                                     BorderThickness="0"/>
                        <TextBlock x:Name="SyncProgressText" 
                                   Text="Ready to sync"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12" Margin="0,10,0,0"/>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,20,0,0">
                        <Button x:Name="SyncNowButton" 
                                Content="🔄 Sync Now" 
                                Style="{StaticResource PrimaryButton}"
                                Click="SyncNowButton_Click"
                                Margin="0,0,10,0"/>
                        <Button x:Name="StartAutoSyncButton" 
                                Content="▶️ Start Auto Sync" 
                                Style="{StaticResource SecondaryButton}"
                                Click="StartAutoSyncButton_Click"
                                Margin="0,0,10,0"/>
                        <Button x:Name="StopAutoSyncButton" 
                                Content="⏹️ Stop" 
                                Style="{StaticResource SecondaryButton}"
                                Click="StopAutoSyncButton_Click"
                                IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Logs and Errors Tabs -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <TabControl Background="Transparent" BorderThickness="0">
                    <!-- Activity Log Tab -->
                    <TabItem Header="Logs">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <Button Content="Clear Logs" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                                    BorderThickness="0" FontSize="11" HorizontalAlignment="Right" Margin="0,5,5,5"
                                    Click="ClearLogButton_Click"/>

                            <ListBox x:Name="ActivityLogList" Grid.Row="1" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8" Margin="0,2" CornerRadius="4" Background="#F8FAFC">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="11" Foreground="#334155"/>
                                                <TextBlock Text="{Binding Timestamp}" FontSize="9" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>

                    <!-- Errors Tab -->
                    <TabItem Header="Errors">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Button Content="Clear Errors" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                                    BorderThickness="0" FontSize="11" HorizontalAlignment="Right" Margin="0,5,5,5"
                                    Click="ClearErrorsButton_Click"/>

                            <ListBox x:Name="ErrorLogList" Grid.Row="1" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8" Margin="0,2" CornerRadius="4" Background="#FEF2F2">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="11" Foreground="#991B1B" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Details}" TextWrapping="Wrap" FontSize="10" Foreground="#B91C1C" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding Timestamp}" FontSize="9" Foreground="#F87171" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3" Margin="0,20,0,0">
            <Grid>
                <TextBlock Text="© 2026 LiveKeeping • Tally Sync v1.0.0" 
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12"
                           HorizontalAlignment="Left"/>
                <TextBlock HorizontalAlignment="Right">
                    <Hyperlink x:Name="SettingsLink" 
                               Foreground="{StaticResource PrimaryBrush}"
                               TextDecorations="None"
                               Click="SettingsLink_Click">
                        ⚙️ Settings
                    </Hyperlink>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
