<Window x:Class="TallySyncApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LiveKeeping Sync - Login" Height="600" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Background="#0F172A">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Logo Area -->
        <StackPanel Margin="40,30,40,20" HorizontalAlignment="Center">
            <Border Width="60" Height="60" Background="White" CornerRadius="15">
                <TextBlock Text="🔄" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="LiveKeeping Sync" Foreground="White" FontSize="22" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,15,0,0"/>
        </StackPanel>

        <!-- Login Card -->
        <Border Grid.Row="1" Background="White" CornerRadius="30,30,0,0" Padding="35,30">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="HeaderText" Text="Welcome Back" FontSize="24" FontWeight="Bold" 
                               Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock x:Name="SubHeaderText" Text="Sign in to your account" Foreground="#64748B" 
                               FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                    <!-- Full Name -->
                    <StackPanel x:Name="FullNamePanel" Visibility="Collapsed" Margin="0,0,0,15">
                        <TextBlock Text="Full Name" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="FullNameBox" Height="42" Padding="12,0" VerticalContentAlignment="Center" FontSize="14"
                                 BorderBrush="#CBD5E1" BorderThickness="1">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>

                    <!-- Email -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Email" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="EmailBox" Height="42" Padding="12,0" VerticalContentAlignment="Center" FontSize="14"
                                 BorderBrush="#CBD5E1" BorderThickness="1">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>

                    <!-- Password -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Password" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <PasswordBox x:Name="PasswordBox" Height="42" Padding="12,0" VerticalContentAlignment="Center" FontSize="14"
                                     BorderBrush="#CBD5E1" BorderThickness="1">
                            <PasswordBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </PasswordBox.Resources>
                        </PasswordBox>
                    </StackPanel>

                    <!-- Error Message -->
                    <Border x:Name="ErrorBorder" Background="#FEF2F2" BorderBrush="#FEE2E2" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,15" Visibility="Collapsed">
                        <TextBlock x:Name="ErrorText" Foreground="#EF4444" FontSize="12" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Login Button -->
                    <Border CornerRadius="8" Background="#0F172A" Margin="0,0,0,15">
                        <Button x:Name="LoginButton" Height="45" Click="LoginButton_Click"
                                Background="Transparent" Foreground="White" FontWeight="Bold" FontSize="14"
                                BorderThickness="0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ButtonIcon" Text="" Margin="0,0,8,0"/>
                                <TextBlock x:Name="ButtonText" Text="Sign In"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- Google Sign-In Button -->
                    <Border CornerRadius="8" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,15">
                        <Button x:Name="GoogleSignInButton" Height="45" Click="GoogleSignInButton_Click"
                                Background="Transparent" Foreground="#1E293B" FontWeight="SemiBold" FontSize="14"
                                BorderThickness="0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Continue with Google" />
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- Loading Indicator -->
                    <StackPanel x:Name="LoadingPanel" Orientation="Horizontal" HorizontalAlignment="Center" 
                                Margin="0,0,0,15" Visibility="Collapsed">
                        <TextBlock x:Name="LoadingText" Text="Signing in..." Foreground="#64748B" FontSize="13"/>
                    </StackPanel>

                    <!-- Toggle to Signup -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <TextBlock x:Name="TogglePrompt" Text="Don't have an account? " Foreground="#64748B" FontSize="13"/>
                        <TextBlock x:Name="ToggleLink" Text="Sign Up" Foreground="#2563EB" FontWeight="SemiBold" 
                                   FontSize="13" Cursor="Hand" MouseDown="ToggleMode_Click">
                            <TextBlock.TextDecorations>
                                <TextDecoration Location="Underline"/>
                            </TextBlock.TextDecorations>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
