<Window x:Class="TallySyncApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TallySyncApp.ViewModels"
        mc:Ignorable="d"
        Title="LiveKeeping Tally Sync" Height="600" Width="900"
        FontFamily="Segoe UI" Background="#F3F4F6">

    <Window.Resources>
        <local:BoolToColorConverter x:Key="BoolToColorConverter" xmlns:local="clr-namespace:TallySyncApp" />
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter" xmlns:local="clr-namespace:TallySyncApp" />
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="White" Padding="20,15" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔄" FontSize="24" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="LiveKeeping Sync" FontWeight="Bold" FontSize="18"/>
                        <TextBlock Text="{Binding Status.CompanyName, StringFormat='Company: {0}'}" 
                                   Foreground="#6B7280" FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{Binding Status.IsTallyConnected, Converter={StaticResource BoolToColorConverter}}" 
                            CornerRadius="12" Padding="10,4" Margin="0,0,10,0">
                        <TextBlock Text="Tally ERP" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="{Binding Status.IsServerConnected, Converter={StaticResource BoolToColorConverter}}" 
                            CornerRadius="12" Padding="10,4">
                        <TextBlock Text="Cloud Server" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <!-- User Info & Logout -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Border Background="#EFF6FF" CornerRadius="20" Padding="12,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="UserEmailText" Text="{Binding UserEmail}" 
                                       Foreground="#1E40AF" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="LogoutButton" Content="Logout" Click="LogoutButton_Click"
                            Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0"
                            Padding="12,6" FontSize="12" FontWeight="SemiBold" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="10">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="20,10"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Name="Border" BorderThickness="0,0,0,2" BorderBrush="Transparent" Margin="0,0,10,0">
                                    <ContentPresenter x:Name="ContentSite"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        ContentSource="Header"
                                        Margin="10,2"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="BorderBrush" Value="#4A90D9"/>
                                        <Setter Property="Foreground" Value="#4A90D9"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- Dashboard Tab -->
            <TabItem Header="Dashboard">
                <Grid Margin="0,20,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Status Banner -->
                    <Border Style="{StaticResource StatusCard}" Margin="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel>
                                <TextBlock Text="Current Status" Foreground="#6B7280" FontSize="12"/>
                                <TextBlock Text="{Binding Status.StatusText}" FontSize="24" FontWeight="Bold" Margin="0,5"/>
                                <TextBlock Text="{Binding Status.Message}" Foreground="#4B5563"/>
                                
                                <ProgressBar Height="8" Minimum="0" Maximum="100" 
                                             Value="{Binding Status.ProgressPercentage, Mode=OneWay, FallbackValue=0}" 
                                             Margin="0,15,0,0" Foreground="#4A90D9"
                                             Background="#E5E7EB" BorderThickness="0"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Button Command="{Binding StartSyncCommand}" Content="▶ Start Auto-Sync" Style="{StaticResource ModernButton}" Margin="0,0,0,10"/>
                                <Button Command="{Binding StopSyncCommand}" Content="⏹ Stop Sync" Background="#EF4444" Style="{StaticResource ModernButton}" Margin="0,0,0,10"/>
                                <Button Command="{Binding ManualSyncCommand}" Content="🔄 Sync Now" Background="#10B981" Style="{StaticResource ModernButton}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Stats Grid -->
                    <Grid Grid.Row="1" Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource StatusCard}">
                            <StackPanel>
                                <TextBlock Text="Last Sync" Foreground="#6B7280"/>
                                <TextBlock Text="{Binding Status.LastSyncTime, StringFormat='{}{0:HH:mm:ss}'}" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Status.LastSyncTime, StringFormat='{}{0:dd MMM yyyy}'}" Foreground="#9CA3AF" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource StatusCard}">
                            <StackPanel>
                                <TextBlock Text="Next Schedule" Foreground="#6B7280"/>
                                <TextBlock Text="{Binding Status.NextSyncTime, StringFormat='{}{0:HH:mm:ss}'}" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Settings.SyncSettings.SyncIntervalMinutes, StringFormat='Every {0} mins'}" Foreground="#9CA3AF" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource StatusCard}">
                            <StackPanel>
                                <TextBlock Text="Pending Queue" Foreground="#6B7280"/>
                                <TextBlock Text="{Binding Status.ProcessedRecords}" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="records" Foreground="#9CA3AF" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Live Logs -->
                    <Border Grid.Row="2" Background="#1E1E1E" CornerRadius="8" Margin="18" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding ConsoleOutput}" FontFamily="Consolas" Foreground="#D4D4D4" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Live Status Tab -->
            <TabItem Header="Live Status">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="#EBF5FF" Padding="15" Margin="10" CornerRadius="8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Total Records Processed (Current Session): " FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SyncItems.Count}" FontWeight="Bold" Foreground="#2563EB"/>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding SyncItems}" AutoGenerateColumns="False" 
                              CanUserAddRows="False" IsReadOnly="True" Margin="10"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              Background="White" BorderThickness="1" BorderBrush="#E5E7EB">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Status" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusIcon}" HorizontalAlignment="Center" FontSize="16"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTextColumn Header="Item Name" Binding="{Binding Name}" Width="250">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Margin" Value="5,2"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100"/>
                            
                            <DataGridTemplateColumn Header="Result" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="5,2">
                                            <TextBlock Text="{Binding Status}" 
                                                       Foreground="{Binding IsSuccess, Converter={StaticResource BoolToColorConverter}}" 
                                                       FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Text="{Binding Error}" 
                                                       Foreground="#EF4444" 
                                                       FontSize="11" 
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding Error, Converter={StaticResource NullToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Settings Tab -->
            <TabItem Header="Settings">
                <ScrollViewer>
                    <StackPanel Margin="20">
                        <TextBlock Text="Tally Configuration" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                        <Border Background="White" Padding="20" CornerRadius="8" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Host (ODBC Server IP)" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Settings.TallySettings.Host}" Padding="5" Margin="0,0,0,15"/>
                                
                                <TextBlock Text="Port (Default: 9000)" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Settings.TallySettings.Port}" Padding="5" Margin="0,0,0,15"/>
                                
                                <Button Command="{Binding TestConnectionCommand}" Content="Test Connection" HorizontalAlignment="Left" Padding="15,8"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Cloud Sync Configuration" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                        <Border Background="White" Padding="20" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="API Endpoint URL" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Settings.SyncSettings.ApiBaseUrl}" Padding="5" Margin="0,0,0,15"/>
                                
                                <TextBlock Text="Company API Key" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Settings.SyncSettings.ApiKey}" Padding="5" Margin="0,0,0,15"/>
                                
                                <TextBlock Text="Sync Interval (Minutes)" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Settings.SyncSettings.SyncIntervalMinutes}" Padding="5" Margin="0,0,0,15"/>
                                
                                <Button Command="{Binding SaveSettingsCommand}" Content="Save Settings" HorizontalAlignment="Left" Style="{StaticResource ModernButton}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Logs History -->
            <TabItem Header="History">
                <DataGrid ItemsSource="{Binding RecentLogs}" AutoGenerateColumns="False" 
                          CanUserAddRows="False" IsReadOnly="True" Margin="10"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="150"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding DataType}" Width="100"/>
                        <DataGridTextColumn Header="Records" Binding="{Binding RecordCount}" Width="80"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Success}" Width="80"/>
                        <DataGridTextColumn Header="Duration" Binding="{Binding DurationMs, StringFormat='{}{0}ms'}" Width="100"/>
                        <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <StatusBar Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock Text="Ready"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="v1.0.0"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
