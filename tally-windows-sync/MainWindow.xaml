<Window x:Class="TallySyncApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TallySyncApp.ViewModels"
        mc:Ignorable="d"
        Title="TallyLink - TallySync" Height="680" Width="1080"
        MinHeight="600" MinWidth="900"
        Icon="app_icon.ico"
        FontFamily="Segoe UI"
        Background="#F3F4F6"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False">

    <Window.Resources>
        <local:BoolToColorConverter x:Key="BoolToColorConverter" xmlns:local="clr-namespace:TallySyncApp" />
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter" xmlns:local="clr-namespace:TallySyncApp" />

        <!-- Sidebar navigation button style -->
        <Style x:Key="NavButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                Height="{TemplateBinding Height}"
                                Padding="{TemplateBinding Padding}">
                            <Border.Child>
                                <Grid>
                                    <!-- Active indicator bar -->
                                    <Border x:Name="ActiveBar"
                                            Width="3"
                                            Height="0"
                                            Background="#2563EB"
                                            CornerRadius="0,3,3,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="14,0,0,0">
                                        <TextBlock x:Name="IconText"
                                                   FontSize="18"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   Margin="0,0,14,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="LabelText"
                                                   Text="{TemplateBinding Content}"
                                                   FontSize="14"
                                                   FontWeight="Medium"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border.Child>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#1E293B"/>
                                <Setter TargetName="ActiveBar" Property="Height" Value="28"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="LabelText" Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Content area style with transition -->
        <Style x:Key="ContentArea" TargetType="Border">
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ======== LEFT SIDEBAR ======== -->
        <Border Grid.Column="0"
                Background="#0F172A"
                Width="220"
                HorizontalAlignment="Left">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- App Branding -->
                <Border Padding="20,24,20,20" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38"
                                Background="#2563EB"
                                CornerRadius="10">
                            <TextBlock Text="⟳" FontSize="20"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontWeight="Bold"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="TallySync"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       LetterSpacing="0.5"/>
                            <TextBlock Text="{Binding Status.CompanyName, StringFormat='{0}'}"
                                       Foreground="#64748B"
                                       FontSize="11"
                                       Margin="0,1,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Navigation Items -->
                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <RadioButton x:Name="NavDashboard"
                                 Content="Dashboard"
                                 Style="{StaticResource NavButtonStyle}"
                                 IsChecked="True"
                                 GroupName="NavGroup"
                                 Checked="NavButton_Checked"
                                 Tag="DashboardPanel">
                        <RadioButton.Resources>
                            <TextBlock x:Key="IconText" Text="📊"/>
                        </RadioButton.Resources>
                    </RadioButton>
                    <RadioButton x:Name="NavSyncStatus"
                                 Content="Sync Status"
                                 Style="{StaticResource NavButtonStyle}"
                                 GroupName="NavGroup"
                                 Checked="NavButton_Checked"
                                 Tag="SyncStatusPanel"/>
                    <RadioButton x:Name="NavSettings"
                                 Content="Settings"
                                 Style="{StaticResource NavButtonStyle}"
                                 GroupName="NavGroup"
                                 Checked="NavButton_Checked"
                                 Tag="SettingsPanel"/>
                    <RadioButton x:Name="NavHistory"
                                 Content="History"
                                 Style="{StaticResource NavButtonStyle}"
                                 GroupName="NavGroup"
                                 Checked="NavButton_Checked"
                                 Tag="HistoryPanel"/>
                </StackPanel>

                <!-- Sidebar Footer -->
                <StackPanel Grid.Row="2"
                            BorderBrush="#1E293B"
                            BorderThickness="0,1,0,0"
                            Padding="16,16"
                            Margin="0,0,0,0">
                    <!-- Connection Status Indicators -->
                    <StackPanel Margin="0,0,0,12">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="8" Height="8"
                                     Fill="{Binding Status.IsTallyConnected, Converter={StaticResource BoolToColorConverter}}"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="Tally Connection"
                                       Foreground="#94A3B8"
                                       FontSize="12"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="8" Height="8"
                                     Fill="{Binding Status.IsServerConnected, Converter={StaticResource BoolToColorConverter}}"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="Cloud Server"
                                       Foreground="#94A3B8"
                                       FontSize="12"/>
                        </Grid>
                    </StackPanel>

                    <!-- Version -->
                    <TextBlock Text="v2.0.1"
                               Foreground="#475569"
                               FontSize="11"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======== RIGHT CONTENT AREA ======== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== TOP HEADER BAR ===== -->
            <Border Background="White"
                    Padding="24,14,24,14"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Page Title -->
                    <TextBlock x:Name="PageTitle"
                               Text="Dashboard"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#1F2937"
                               VerticalAlignment="Center"/>

                    <!-- Sync Status Badge -->
                    <Border Grid.Column="1"
                            Background="#EFF6FF"
                            CornerRadius="20"
                            Padding="14,6"
                            Margin="0,0,14,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Status.StatusText}"
                                       Foreground="#1E40AF"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- User Info + Logout -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Background="#F3F4F6"
                                CornerRadius="20"
                                Padding="12,6"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="22" Height="22"
                                        Background="#2563EB"
                                        CornerRadius="11"
                                        Margin="0,0,8,0">
                                    <TextBlock Text="👤" FontSize="12"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="UserEmailText"
                                           Text="{Binding UserEmail}"
                                           Foreground="#374151"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="LogoutButton"
                                Click="LogoutButton_Click"
                                Content="Logout"
                                Background="#FEE2E2"
                                Foreground="#DC2626"
                                BorderThickness="0"
                                Padding="14,6"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                MinHeight="34">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== CONTENT PANELS ===== -->

            <!-- DASHBOARD PANEL -->
            <ScrollViewer x:Name="DashboardPanel"
                          Grid.Row="1"
                          Background="#F9FAFB"
                          Visibility="Visible">
                <Grid Margin="24,20,24,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- KPI Cards Row -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- KPI Card 1: Records Synced -->
                        <Border Grid.Column="0" Style="{StaticResource KpiCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Width="36" Height="36"
                                            Background="#DBEAFE"
                                            CornerRadius="10"
                                            Margin="0,0,12,0">
                                        <TextBlock Text="📥" FontSize="18"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Records Synced"
                                               Foreground="#6B7280"
                                               FontSize="13"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding Status.ProcessedRecords}"
                                           FontSize="32"
                                           FontWeight="Bold"
                                           Foreground="#1F2937"/>
                                <TextBlock Grid.Row="2"
                                           Text="Total this session"
                                           Foreground="#9CA3AF"
                                           FontSize="12"
                                           Margin="0,4,0,0"/>
                            </Grid>
                        </Border>

                        <!-- KPI Card 2: Last Sync Time -->
                        <Border Grid.Column="1" Style="{StaticResource KpiCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Width="36" Height="36"
                                            Background="#FEF3C7"
                                            CornerRadius="10"
                                            Margin="0,0,12,0">
                                        <TextBlock Text="⏰" FontSize="18"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Last Sync"
                                               Foreground="#6B7280"
                                               FontSize="13"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding Status.LastSyncTime, StringFormat='{}{0:HH:mm:ss}'}"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="#1F2937"/>
                                <TextBlock Grid.Row="2"
                                           Text="{Binding Status.LastSyncTime, StringFormat='{}{0:dd MMM yyyy}'}"
                                           Foreground="#9CA3AF"
                                           FontSize="12"
                                           Margin="0,4,0,0"/>
                            </Grid>
                        </Border>

                        <!-- KPI Card 3: Sync Progress -->
                        <Border Grid.Column="2" Style="{StaticResource KpiCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Width="36" Height="36"
                                            Background="#D1FAE5"
                                            CornerRadius="10"
                                            Margin="0,0,12,0">
                                        <TextBlock Text="⚡" FontSize="18"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Progress"
                                               Foreground="#6B7280"
                                               FontSize="13"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding Status.ProgressPercentage, StringFormat='{}{0}%'}"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="#2563EB"/>
                                <TextBlock Grid.Row="2"
                                           Text="{Binding Status.TotalRecords, StringFormat='{0} total records'}"
                                           Foreground="#9CA3AF"
                                           FontSize="12"
                                           Margin="0,4,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Status Banner & Progress -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Status Header -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Sync Status"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#1F2937"/>
                                    <TextBlock Text="{Binding Status.Message}"
                                               Foreground="#6B7280"
                                               FontSize="13"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Command="{Binding ManualSyncCommand}"
                                            Content="⟳ Sync Now"
                                            Style="{StaticResource ModernButton}"
                                            MinWidth="100"
                                            Height="36"
                                            FontSize="13"
                                            Padding="14,0"
                                            Margin="0,0,8,0"/>
                                    <Button Command="{Binding StartSyncCommand}"
                                            Content="▶ Auto-Sync"
                                            Background="#10B981"
                                            Style="{StaticResource ModernButton}"
                                            MinWidth="100"
                                            Height="36"
                                            FontSize="13"
                                            Padding="14,0"
                                            Margin="0,0,8,0">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                    <Button Command="{Binding StopSyncCommand}"
                                            Content="⏹ Stop"
                                            Style="{StaticResource DangerButton}"
                                            MinWidth="80"
                                            Height="36"
                                            FontSize="13"
                                            Padding="14,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Progress Bar -->
                            <Grid Grid.Row="1" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar Height="10"
                                             Minimum="0" Maximum="100"
                                             Value="{Binding Status.ProgressPercentage, Mode=OneWay, FallbackValue=0}"
                                             Foreground="#2563EB"
                                             Background="#E5E7EB"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Status.ProgressPercentage, StringFormat='{}{0}%'}"
                                           Foreground="#6B7280"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Stats row under progress -->
                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Grid.Column="0">
                                    <TextBlock Text="Total: " Foreground="#9CA3AF" FontSize="12"/>
                                    <TextBlock Text="{Binding Status.TotalRecords}"
                                               Foreground="#374151" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Grid.Column="1">
                                    <TextBlock Text="Processed: " Foreground="#9CA3AF" FontSize="12"/>
                                    <TextBlock Text="{Binding Status.ProcessedRecords}"
                                               Foreground="#10B981" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Grid.Column="2">
                                    <TextBlock Text="Next sync: " Foreground="#9CA3AF" FontSize="12"/>
                                    <TextBlock Text="{Binding Status.NextSyncTime, StringFormat='{}{0:HH:mm:ss}'}"
                                               Foreground="#374151" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Live Log Terminal -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Terminal Header -->
                            <Border Background="#1E1E1E"
                                    CornerRadius="12,12,0,0"
                                    Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Terminal dots -->
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" Fill="#EF4444" Margin="0,0,6,0"/>
                                        <Ellipse Width="10" Height="10" Fill="#F59E0B" Margin="0,0,6,0"/>
                                        <Ellipse Width="10" Height="10" Fill="#10B981"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="Live Console Log"
                                               Foreground="#9CA3AF"
                                               FontSize="12"
                                               FontFamily="Consolas"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="2"
                                               Text="terminal"
                                               Foreground="#6B7280"
                                               FontSize="11"
                                               FontFamily="Consolas"
                                               FontStyle="Italic"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Terminal Content -->
                            <Border Grid.Row="1"
                                    Background="#1E1E1E"
                                    CornerRadius="0,0,12,12"
                                    Padding="16,12"
                                    MinHeight="200"
                                    MaxHeight="300">
                                <ScrollViewer x:Name="LogScrollViewer"
                                              VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding ConsoleOutput}"
                                               FontFamily="Consolas"
                                               Foreground="#4ADE80"
                                               FontSize="13"
                                               LineHeight="20"
                                               TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- SYNC STATUS PANEL -->
            <Grid x:Name="SyncStatusPanel"
                  Grid.Row="1"
                  Visibility="Collapsed"
                  Margin="24,20,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Session Records: "
                                   Foreground="#374151" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SyncItems.Count}"
                                   Foreground="#2563EB" FontSize="20" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding SyncItems}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          Background="White"
                          BorderThickness="0"
                          RowBackground="White"
                          AlternatingRowBackground="#F9FAFB"
                          GridLinesVisibility="None"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          Margin="0">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F3F4F6"/>
                            <Setter Property="Foreground" Value="#374151"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="BorderBrush" Value="#E5E7EB"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="BorderBrush" Value="#F3F4F6"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="MinHeight" Value="42"/>
                            <Setter Property="Background" Value="White"/>
                            <Style.Triggers>
                                <Trigger Property="AlternationIndex" Value="1">
                                    <Setter Property="Background" Value="#F9FAFB"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Status" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatusIcon}"
                                               HorizontalAlignment="Center"
                                               FontSize="16"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Item Name" Binding="{Binding Name}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Margin" Value="4,2"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120"/>

                        <DataGridTemplateColumn Header="Result" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,2">
                                        <TextBlock Text="{Binding Status}"
                                                   Foreground="{Binding IsSuccess, Converter={StaticResource BoolToColorConverter}}"
                                                   FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Text="{Binding Error}"
                                                   Foreground="#EF4444"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding Error, Converter={StaticResource NullToVisibilityConverter}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Time"
                                            Binding="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"
                                            Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- SETTINGS PANEL -->
            <ScrollViewer x:Name="SettingsPanel"
                          Grid.Row="1"
                          Visibility="Collapsed"
                          Background="#F9FAFB">
                <StackPanel Margin="24,20,24,20" MaxWidth="700">
                    <!-- Tally Configuration -->
                    <TextBlock Text="Tally Configuration"
                               FontSize="16" FontWeight="Bold"
                               Foreground="#1F2937"
                               Margin="0,0,0,12"/>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="Host (ODBC Server IP)"
                                       Foreground="#374151"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>
                            <TextBox Text="{Binding Settings.TallySettings.Host}"
                                     Style="{StaticResource ModernTextBox}"
                                     Margin="0,0,0,16"/>

                            <TextBlock Text="Port (Default: 9000)"
                                       Foreground="#374151"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>
                            <TextBox Text="{Binding Settings.TallySettings.Port}"
                                     Style="{StaticResource ModernTextBox}"
                                     Margin="0,0,0,16"/>

                            <Button Command="{Binding TestConnectionCommand}"
                                    Content="Test Connection"
                                    Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Left"
                                    Height="38"
                                    Padding="20,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Cloud Sync Configuration -->
                    <TextBlock Text="Cloud Sync Configuration"
                               FontSize="16" FontWeight="Bold"
                               Foreground="#1F2937"
                               Margin="0,0,0,12"/>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="API Endpoint URL"
                                       Foreground="#374151"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>
                            <TextBox Text="{Binding Settings.SyncSettings.ApiBaseUrl}"
                                     Style="{StaticResource ModernTextBox}"
                                     Margin="0,0,0,16"/>

                            <TextBlock Text="Company API Key"
                                       Foreground="#374151"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>
                            <TextBox Text="{Binding Settings.SyncSettings.ApiKey}"
                                     Style="{StaticResource ModernTextBox}"
                                     Margin="0,0,0,16"/>

                            <TextBlock Text="Sync Interval (Minutes)"
                                       Foreground="#374151"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>
                            <TextBox Text="{Binding Settings.SyncSettings.SyncIntervalMinutes}"
                                     Style="{StaticResource ModernTextBox}"
                                     Margin="0,0,0,8"/>

                            <Button Command="{Binding SaveSettingsCommand}"
                                    Content="Save Settings"
                                    Style="{StaticResource ModernButton}"
                                    HorizontalAlignment="Left"
                                    Height="40"
                                    Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- HISTORY PANEL -->
            <Grid x:Name="HistoryPanel"
                  Grid.Row="1"
                  Visibility="Collapsed"
                  Margin="24,20,24,20">
                <DataGrid ItemsSource="{Binding RecentLogs}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          Background="White"
                          BorderThickness="0"
                          RowBackground="White"
                          AlternatingRowBackground="#F9FAFB"
                          GridLinesVisibility="None"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F3F4F6"/>
                            <Setter Property="Foreground" Value="#374151"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="BorderBrush" Value="#E5E7EB"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="BorderBrush" Value="#F3F4F6"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="MinHeight" Value="40"/>
                            <Setter Property="Background" Value="White"/>
                            <Style.Triggers>
                                <Trigger Property="AlternationIndex" Value="1">
                                    <Setter Property="Background" Value="#F9FAFB"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time"
                                            Binding="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                                            Width="160"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding DataType}" Width="120"/>
                        <DataGridTextColumn Header="Records" Binding="{Binding RecordCount}" Width="80"/>
                        <DataGridTemplateColumn Header="Status" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Success, Converter={x:Null}}"
                                               Foreground="{Binding Success, Converter={StaticResource BoolToColorConverter}}"
                                               FontWeight="SemiBold"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Duration"
                                            Binding="{Binding DurationMs, StringFormat='{}{0}ms'}"
                                            Width="100"/>
                        <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- ===== STATUS BAR (Footer) ===== -->
            <StatusBar Grid.Row="2"
                       Background="White"
                       BorderBrush="#E5E7EB"
                       BorderThickness="0,1,0,0"
                       Height="28">
                <StatusBarItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="● "
                                   Foreground="{Binding Status.IsTallyConnected, Converter={StaticResource BoolToColorConverter}}"
                                   FontSize="10"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Tally"
                                   Foreground="#6B7280" FontSize="11"
                                   Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <TextBlock Text="● "
                                   Foreground="{Binding Status.IsServerConnected, Converter={StaticResource BoolToColorConverter}}"
                                   FontSize="10"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Cloud"
                                   Foreground="#6B7280" FontSize="11"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StatusBarItem>
                <StatusBarItem HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Status.State}"
                               Foreground="#9CA3AF" FontSize="11"/>
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </Grid>
</Window>
