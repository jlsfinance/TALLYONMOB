<Window x:Class="TallySyncApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TallySyncApp.ViewModels"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="SYNCORA Connector" Height="780" Width="1160"
        MinHeight="640" MinWidth="960"
        Icon="app_icon.ico"
        FontFamily="Segoe UI"
        Background="#F5F7FA"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False">

    <Window.Resources>
        <local:BoolToColorConverter x:Key="BoolToColorConverter" xmlns:local="clr-namespace:TallySyncApp" />
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter" xmlns:local="clr-namespace:TallySyncApp" />
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" xmlns:local="clr-namespace:TallySyncApp" />
        <local:StringToBrushConverter x:Key="StringToBrushConverter" xmlns:local="clr-namespace:TallySyncApp" />
        <local:InverseBoolConverter x:Key="InverseBoolConverter" xmlns:local="clr-namespace:TallySyncApp" />

        <!-- Apple / Google Light Frosted Sidebar Pill -->
        <Style x:Key="NavButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="12,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="RootBorder"
                                CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="ActiveBar"
                                        Width="3"
                                        Height="0"
                                        Background="#059669"
                                        CornerRadius="2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="10,0,0,0">
                                    <TextBlock x:Name="IconText"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Width="22"
                                               TextAlignment="Center"
                                               Foreground="#64748B"
                                               Margin="0,0,12,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="LabelText"
                                               Text="{TemplateBinding Content}"
                                               FontSize="13.5"
                                               FontWeight="Medium"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#ECFDF5"/>
                                <Setter TargetName="ActiveBar" Property="Height" Value="20"/>
                                <Setter TargetName="IconText" Property="Foreground" Value="#059669"/>
                                <Setter Property="Foreground" Value="#065F46"/>
                                <Setter TargetName="LabelText" Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ContentArea" TargetType="Border">
            <Setter Property="Background" Value="#F5F7FA"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <!-- Shared Apple-Style Per-Company Card DataTemplate (Dashboard + Sync Status) -->
        <DataTemplate x:Key="CompanyCardTemplate">
            <Border Background="White"
                    BorderBrush="#E6EAF0"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16,14"
                    Margin="0,0,0,10"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Row: Company Identity + Badges + Quick Action Buttons -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Company Icon Tile -->
                        <Border Grid.Column="0"
                                Width="38" Height="38"
                                CornerRadius="11"
                                Background="{Binding IconBg, Converter={StaticResource StringToBrushConverter}}"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#xE731;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       Foreground="{Binding IconFg, Converter={StaticResource StringToBrushConverter}}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- Name, Open/Closed Pill, Sync Pill, Warning Tooltip, Subtitle -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#0F172A"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>

                                <!-- Open / Closed Tally Pill -->
                                <Border Background="{Binding OpenBadgeBg, Converter={StaticResource StringToBrushConverter}}"
                                        CornerRadius="10"
                                        Padding="8,3"
                                        Margin="0,0,6,0"
                                        ToolTip="{Binding OpenBadgeTooltip}"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6"
                                                 Fill="{Binding OpenDotColor, Converter={StaticResource StringToBrushConverter}}"
                                                 Margin="0,0,5,0"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding OpenBadgeText}"
                                                   Foreground="{Binding OpenBadgeFg, Converter={StaticResource StringToBrushConverter}}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>

                                <!-- Sync State Pill -->
                                <Border Background="{Binding SyncStatusBg, Converter={StaticResource StringToBrushConverter}}"
                                        CornerRadius="10"
                                        Padding="8,3"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SyncStateLabel}"
                                               Foreground="{Binding SyncStatusFg, Converter={StaticResource StringToBrushConverter}}"
                                               FontSize="11"
                                               FontWeight="SemiBold"/>
                                </Border>

                                <!-- Attention / Warning Badge with Tooltip -->
                                <Border Background="#FEF3C7"
                                        BorderBrush="#FDE68A"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="7,2"
                                        Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibilityConverter}}"
                                        ToolTip="{Binding WarningTooltip}"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7BA;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="11"
                                                   Foreground="#B45309"
                                                   Margin="0,0,4,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="Issue"
                                                   Foreground="#92400E"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding SubtitleText}"
                                           ToolTip="{Binding DataPath}"
                                           Foreground="#64748B"
                                           FontSize="11.5"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="420"/>
                                <TextBlock Text=" · "
                                           Foreground="#CBD5E1"
                                           FontSize="11.5"/>
                                <TextBlock Text="{Binding LastSyncText}"
                                           Foreground="#475569"
                                           FontSize="11.5"
                                           FontWeight="Medium"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Quick-Action Buttons: Sync, Open Web, Open Tally Folder, Reset -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding DataContext.SyncCompanyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding CanSyncCompany}"
                                    ToolTip="Sync this company now"
                                    Style="{StaticResource ModernButton}"
                                    MinHeight="32"
                                    Height="32"
                                    Padding="12,0"
                                    FontSize="12"
                                    Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE895;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="12.5"
                                               Margin="0,0,6,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Sync" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding DataContext.OpenCompanyWebCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Content="&#xE774;"
                                    ToolTip="Open Web Dashboard"
                                    Style="{StaticResource CardIconButton}"
                                    Margin="0,0,6,0"/>

                            <Button Command="{Binding DataContext.OpenCompanyFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Content="&#xE8B7;"
                                    ToolTip="Open Tally Data Folder"
                                    Style="{StaticResource CardIconButton}"
                                    Margin="0,0,6,0"/>

                            <Button Command="{Binding DataContext.ResetCompanyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding CanSyncCompany}"
                                    Content="&#xE72C;"
                                    ToolTip="Reset &amp; Full Resync company"
                                    Style="{StaticResource CardIconButton}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Bottom Row: Per-Company Progress Bar + Status Text -->
                    <Grid Grid.Row="1" Margin="50,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar Grid.Column="0"
                                     Height="6"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding ProgressPercent, Mode=OneWay, FallbackValue=0}"
                                     Foreground="{Binding ProgressBarColor, Converter={StaticResource StringToBrushConverter}}"
                                     VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ProgressMessage}"
                                       Foreground="#64748B"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ProgressPercent, StringFormat=' ({0}%)'}"
                                       Visibility="{Binding IsSyncing, Converter={StaticResource BoolToVisibilityConverter}}"
                                       Foreground="#2563EB"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ======== APPLE / GOOGLE LIGHT SIDEBAR ======== -->
        <Border Grid.Column="0"
                Background="White"
                BorderBrush="#E6EAF0"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- App Branding -->
                <Border Padding="18,20,18,18" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" Background="#0F172A" CornerRadius="11" ClipToBounds="True">
                            <Image Source="syncora-connector.png" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="SYNCORA"
                                       Foreground="#0F172A"
                                       FontSize="15.5"
                                       FontWeight="Bold"/>
                            <TextBlock Text="TALLY CONNECTOR"
                                       Foreground="#059669"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Margin="0,1,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Navigation Items -->
                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                    <RadioButton x:Name="NavDashboard"
                                 Content="Dashboard"
                                 Style="{StaticResource NavButtonStyle}"
                                 IsChecked="True"
                                 GroupName="NavGroup"
                                 Checked="NavButton_Checked"
                                 Tag="DashboardPanel"/>
                    <RadioButton x:Name="NavSyncStatus"
                                 Content="Sync Status"
                                 Style="{StaticResource NavButtonStyle}"
                                 GroupName="NavGroup"
                                 Checked="NavButton_Checked"
                                 Tag="SyncStatusPanel"/>
                    <RadioButton x:Name="NavSettings"
                                 Content="Settings"
                                 Style="{StaticResource NavButtonStyle}"
                                 GroupName="NavGroup"
                                 Checked="NavButton_Checked"
                                 Tag="SettingsPanel"/>
                    <RadioButton x:Name="NavHistory"
                                 Content="History"
                                 Style="{StaticResource NavButtonStyle}"
                                 GroupName="NavGroup"
                                 Checked="NavButton_Checked"
                                 Tag="HistoryPanel"/>
                    <RadioButton x:Name="NavLicenseHistory"
                                 Content="License History"
                                 Style="{StaticResource NavButtonStyle}"
                                 GroupName="NavGroup"
                                 Checked="NavButton_Checked"
                                 Tag="LicenseHistoryPanel"/>
                </StackPanel>

                <!-- Sidebar Footer Card -->
                <Border Grid.Row="2" Padding="14,0,14,16">
                    <StackPanel>
                        <Border Background="#F8FAFC"
                                BorderBrush="#E6EAF0"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12,10"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8"
                                             Fill="{Binding Status.IsTallyConnected, Converter={StaticResource BoolToColorConverter}}"
                                             Margin="0,0,8,0"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="Tally Connection"
                                               Foreground="#334155"
                                               FontSize="12"
                                               FontWeight="Medium"/>
                                </Grid>
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8"
                                             Fill="{Binding Status.IsServerConnected, Converter={StaticResource BoolToColorConverter}}"
                                             Margin="0,0,8,0"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="Cloud Server"
                                               Foreground="#334155"
                                               FontSize="12"
                                               FontWeight="Medium"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="SidebarWhatsAppDot"
                                             Width="8" Height="8"
                                             Fill="#94A3B8"
                                             Margin="0,0,8,0"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="WhatsApp Bot"
                                               Foreground="#334155"
                                               FontSize="12"
                                               FontWeight="Medium"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="SidebarVersionText"
                                   Text=""
                                   Foreground="#64748B"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ======== RIGHT CONTENT AREA ======== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== TOP HEADER BAR + AUTO-UPDATE BANNER ===== -->
            <StackPanel Grid.Row="0">
            <Border Background="White"
                    Padding="24,14"
                    BorderBrush="#E6EAF0"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Page Title + Active Company -->
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock x:Name="PageTitle"
                                   Text="Dashboard"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CompanyDisplayName}"
                                   ToolTip="{Binding CompanyDisplayName}"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Sync Status Pill -->
                    <Border Grid.Column="1"
                            Background="#ECFDF5"
                            BorderBrush="#A7F3D0"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="14,6"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding Status.StatusText}"
                                   Foreground="#047857"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- Account Pill + Logout -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Background="#F8FAFC"
                                BorderBrush="#E6EAF0"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="12,6"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="22" Height="22"
                                        Background="#E0E7FF"
                                        CornerRadius="11"
                                        Margin="0,0,8,0">
                                    <TextBlock Text="&#xE77B;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="11"
                                               Foreground="#4F46E5"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="UserEmailText"
                                           Text="{Binding UserEmail}"
                                           Foreground="#334155"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="LogoutButton"
                                Click="LogoutButton_Click"
                                Content="Logout"
                                Style="{StaticResource DangerButton}"
                                MinHeight="34"
                                Padding="14,0"
                                FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Antigravity-style Update Banner (auto-downloads in background, Restart & Update applies) -->
            <Border x:Name="UpdateBannerBorder"
                    Visibility="Collapsed"
                    Background="#ECFDF5"
                    BorderBrush="#A7F3D0"
                    BorderThickness="0,0,0,1"
                    Padding="24,9">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="RestartUpdateButton"
                                Content="Restart &amp; Update"
                                Click="RestartUpdateButton_Click"
                                Style="{StaticResource ModernButton}"
                                Visibility="Collapsed"
                                MinHeight="32"
                                Height="32"
                                Padding="14,0"
                                FontSize="12"
                                Margin="0,0,8,0"/>
                        <Button Content="Later"
                                Click="DismissUpdateBanner_Click"
                                Style="{StaticResource GhostButton}"
                                MinHeight="32"
                                Height="32"
                                Padding="12,0"
                                FontSize="12"/>
                    </StackPanel>
                    <TextBlock x:Name="UpdateBannerText"
                               Text="Checking for updates..."
                               Foreground="#065F46"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,12,0"/>
                </DockPanel>
            </Border>
            </StackPanel>

            <!-- ===== CONTENT PANELS ===== -->

            <!-- DASHBOARD PANEL -->
            <ScrollViewer x:Name="DashboardPanel"
                          Grid.Row="1"
                          Background="#F5F7FA"
                          Visibility="Visible">
                <Grid Margin="24,20,24,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: 4 Uniform Apple/Google KPI Cards -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- KPI Card 1: Records Synced -->
                        <Border Grid.Column="0" Style="{StaticResource KpiCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Width="34" Height="34" Background="#EFF6FF" CornerRadius="10" Margin="0,0,10,0">
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#2563EB"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Records Synced" Foreground="#64748B" FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding CloudRecordsText}"
                                           ToolTip="{Binding CloudRecordsDetail}"
                                           FontSize="28" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Synced in cloud" Foreground="#94A3B8" FontSize="11.5" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- KPI Card 2: Last Sync Time -->
                        <Border Grid.Column="2" Style="{StaticResource KpiCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Width="34" Height="34" Background="#FFFBEB" CornerRadius="10" Margin="0,0,10,0">
                                        <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#D97706"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Last Sync" Foreground="#64748B" FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding CloudLastSyncTime}"
                                           FontSize="26" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="{Binding CloudLastSyncDate}" Foreground="#94A3B8" FontSize="11.5" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- KPI Card 3: Sync Progress -->
                        <Border Grid.Column="4" Style="{StaticResource KpiCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Width="34" Height="34" Background="#ECFDF5" CornerRadius="10" Margin="0,0,10,0">
                                        <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#059669"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Progress" Foreground="#64748B" FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Status.ProgressPercentage, StringFormat='{}{0}%'}"
                                           FontSize="28" FontWeight="Bold" Foreground="#059669"/>
                                <TextBlock Text="{Binding Status.TotalRecords, StringFormat='{}{0} total records'}" Foreground="#94A3B8" FontSize="11.5" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- KPI Card 4: License (with inline Extend chip) -->
                        <Border Grid.Column="6" Style="{StaticResource KpiCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right"
                                            Command="{Binding BuyLicenceCommand}"
                                            Content="Extend"
                                            Background="#EEF2FF"
                                            Foreground="#4F46E5"
                                            BorderBrush="#C7D2FE"
                                            BorderThickness="1"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Padding="9,3"
                                            MinHeight="24"
                                            Cursor="Hand"
                                            VerticalAlignment="Center">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="12"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="34" Height="34" Background="#EEF2FF" CornerRadius="10" Margin="0,0,10,0">
                                            <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#4F46E5"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="License" Foreground="#64748B" FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Text="{Binding LicensePlan}"
                                           FontSize="24" FontWeight="Bold" Foreground="#0F172A"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding LicenseDetail}"
                                           Foreground="#94A3B8" FontSize="11.5" Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Row 1: Sync Status & Engine Card -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header + Action Buttons -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="38" Height="38" Background="#ECFDF5" CornerRadius="11" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#059669"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Sync Engine"
                                                   FontSize="15.5" FontWeight="SemiBold" Foreground="#0F172A"/>
                                        <TextBlock Text="{Binding Status.Message}"
                                                   Foreground="#64748B" FontSize="12.5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Command="{Binding ManualSyncCommand}"
                                            IsEnabled="{Binding CanTriggerSync}"
                                            Content="Sync Now"
                                            Style="{StaticResource ModernButton}"
                                            Height="36" Padding="15,0" FontSize="12.5" Margin="0,0,8,0"
                                            ToolTip="Incremental sync - sirf naya/badla hua data (ALTERID se)"/>
                                    <Button Command="{Binding StartSyncCommand}"
                                            IsEnabled="{Binding CanStartAutoSync}"
                                            Content="Auto-Sync"
                                            Background="#ECFDF5"
                                            Foreground="#047857"
                                            BorderBrush="#A7F3D0"
                                            BorderThickness="1"
                                            Style="{StaticResource GhostButton}"
                                            Height="36" Padding="14,0" FontSize="12.5" Margin="0,0,8,0"/>
                                    <Button Command="{Binding FullResyncCommand}"
                                            IsEnabled="{Binding CanTriggerSync}"
                                            Content="Full Resync"
                                            Style="{StaticResource GhostButton}"
                                            Height="36" Padding="14,0" FontSize="12.5" Margin="0,0,8,0"
                                            ToolTip="Poora historical data dobara upload karta hai"/>
                                    <Button Command="{Binding StopSyncCommand}"
                                            IsEnabled="{Binding CanStopSync}"
                                            Content="Stop"
                                            Style="{StaticResource DangerButton}"
                                            Height="36" Padding="14,0" FontSize="12.5"/>
                                </StackPanel>
                            </Grid>

                            <!-- Friendly Tally Closed Banner + 1-Click Open Tally CTA -->
                            <Border Grid.Row="1"
                                    Visibility="{Binding IsTallyDisconnected, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Background="#FFFBEB"
                                    BorderBrush="#FDE68A"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14,12"
                                    Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="34" Height="34" Background="#FEF3C7" CornerRadius="10" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#D97706"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="Tally is closed"
                                                   Foreground="#92400E" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding TallyClosedBannerText}"
                                                   Foreground="#B45309" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Command="{Binding OpenTallyCommand}"
                                                Style="{StaticResource AmberActionButton}"
                                                Margin="0,0,8,0"
                                                ToolTip="Launch TallyPrime / Tally.ERP 9 on this PC">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Open Tally" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding TestConnectionCommand}"
                                                Content="Check Again"
                                                Style="{StaticResource GhostButton}"
                                                MinHeight="34" Height="34" Padding="12,0" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Progress Bar -->
                            <Grid Grid.Row="2" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar Height="8"
                                             Minimum="0" Maximum="100"
                                             Value="{Binding Status.ProgressPercentage, Mode=OneWay, FallbackValue=0}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Status.ProgressPercentage, StringFormat='{}{0}%'}"
                                           Foreground="#475569" FontSize="12" FontWeight="SemiBold"
                                           Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Subtle Metrics Row -->
                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="0,0,22,0">
                                    <TextBlock Text="Total: " Foreground="#94A3B8" FontSize="12"/>
                                    <TextBlock Text="{Binding Status.TotalRecords}" Foreground="#334155" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="0,0,22,0">
                                    <TextBlock Text="Processed: " Foreground="#94A3B8" FontSize="12"/>
                                    <TextBlock Text="{Binding Status.ProcessedRecords}" Foreground="#059669" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Grid.Column="2" Margin="0,0,22,0">
                                    <TextBlock Text="Next sync: " Foreground="#94A3B8" FontSize="12"/>
                                    <TextBlock Text="{Binding Status.NextSyncTime, StringFormat='{}{0:HH:mm:ss}'}" Foreground="#334155" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Grid.Column="3"
                                           Text="{Binding CloudDataStatus}"
                                           Foreground="#94A3B8"
                                           FontSize="11.5"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding CloudDataStatus}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Row 2: Per-Company Cards Section -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12" LastChildFill="True">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#F1F5F9"
                                            CornerRadius="12"
                                            Padding="10,4"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CompaniesSummaryText}"
                                                   Foreground="#475569"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                    <Button Command="{Binding RefreshCompaniesCommand}"
                                            Content="Refresh"
                                            Style="{StaticResource GhostButton}"
                                            MinHeight="32"
                                            Height="32"
                                            Padding="12,0"
                                            FontSize="12"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="34" Height="34" Background="#EEF2FF" CornerRadius="10" Margin="0,0,10,0">
                                        <TextBlock Text="&#xE731;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#4F46E5"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Tally Companies"
                                                   FontSize="15.5" FontWeight="SemiBold" Foreground="#0F172A"/>
                                        <TextBlock Text="Har company ka status, progress aur quick actions (Sync · Web · Folder · Reset)"
                                                   Foreground="#64748B" FontSize="12" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding CompanyCards}"
                                          ItemTemplate="{StaticResource CompanyCardTemplate}"
                                          Visibility="{Binding HasCompanyCards, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <Border Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16,14"
                                    Visibility="{Binding HasCompanyCards, Converter={StaticResource InverseBoolConverter}}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#64748B"
                                               Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="No open or cloud-synced companies found yet. Open Tally and load a company to start syncing."
                                               Foreground="#64748B" FontSize="12.5" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Row 3: WhatsApp Notifications Card (Directly on Dashboard, matching other cards) -->
                    <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                <Border Width="42" Height="42" Background="#DCFCE7" CornerRadius="12" Margin="0,0,14,0" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#16A34A"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="WhatsApp Notifications"
                                                   FontSize="15.5" FontWeight="SemiBold" Foreground="#0F172A"
                                                   VerticalAlignment="Center"/>
                                        <Border x:Name="DashboardWhatsAppPill"
                                                Background="#F1F5F9"
                                                CornerRadius="12"
                                                Padding="10,4"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="DashboardWhatsAppDot"
                                                         Width="7" Height="7"
                                                         Fill="#94A3B8"
                                                         Margin="0,0,6,0"
                                                         VerticalAlignment="Center"/>
                                                <TextBlock x:Name="DashboardWhatsAppStatusText"
                                                           Text="Checking..."
                                                           Foreground="#475569"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Auto-sends live sync alerts, 8 PM closing report &amp; desi Hindi voucher PDFs (Owner + Party)."
                                               Foreground="#64748B" FontSize="12.5" Margin="0,4,0,8" TextWrapping="Wrap"/>
                                    <CheckBox Content="Auto-send new voucher PDF to Party WhatsApp (when mobile is saved in Tally)"
                                              IsChecked="{Binding Settings.SyncSettings.AutoSendPartyWhatsApp, Mode=TwoWay}"
                                              Command="{Binding SaveSettingsCommand}"
                                              Foreground="#334155"
                                              FontSize="12.5"
                                              FontWeight="Medium"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Open WhatsApp QR"
                                        Click="OpenWhatsAppQr_Click"
                                        Style="{StaticResource ModernButton}"
                                        Height="36"
                                        Padding="16,0"
                                        FontSize="12.5"
                                        Margin="0,0,8,0"/>
                                <Button Content="Refresh"
                                        Click="RefreshWhatsAppStatus_Click"
                                        Style="{StaticResource GhostButton}"
                                        Height="36"
                                        Padding="14,0"
                                        FontSize="12.5"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Row 4: Clean Dark Activity Console Card -->
                    <Border Grid.Row="4"
                            Margin="0,16,0,0"
                            Background="#0F172A"
                            BorderBrush="#1E293B"
                            BorderThickness="1"
                            CornerRadius="16"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Console Header -->
                            <Border Padding="18,12" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Live Sync Activity"
                                                   Foreground="#E2E8F0"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Border Grid.Column="2" Background="#134E4A" CornerRadius="10" Padding="8,3">
                                        <TextBlock Text="LIVE"
                                                   Foreground="#5EEAD4"
                                                   FontSize="10"
                                                   FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Console Content -->
                            <Border Grid.Row="1"
                                    Padding="18,12"
                                    MinHeight="170"
                                    MaxHeight="260">
                                <ScrollViewer x:Name="LogScrollViewer"
                                              VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding ConsoleOutput}"
                                               FontFamily="Consolas"
                                               Foreground="#86EFAC"
                                               FontSize="12.5"
                                               LineHeight="20"
                                               TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- SYNC STATUS PANEL -->
            <Grid x:Name="SyncStatusPanel"
                  Grid.Row="1"
                  Visibility="Collapsed"
                  Margin="24,20,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Per-Company Cards Overview -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10" LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding OpenTallyCommand}"
                                        Visibility="{Binding IsTallyDisconnected, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Content="Open Tally"
                                        Style="{StaticResource AmberActionButton}"
                                        MinHeight="32" Height="32" Padding="12,0" FontSize="12" Margin="0,0,8,0"/>
                                <Button Command="{Binding RefreshCompaniesCommand}"
                                        Content="Refresh"
                                        Style="{StaticResource GhostButton}"
                                        MinHeight="32" Height="32" Padding="12,0" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Tally Companies"
                                           FontSize="15.5" FontWeight="SemiBold" Foreground="#0F172A"
                                           Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <Border Background="#F1F5F9" CornerRadius="10" Padding="9,3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CompaniesSummaryText}" Foreground="#475569" FontSize="11.5" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </DockPanel>

                        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding HasCompanyCards, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding CompanyCards}"
                                          ItemTemplate="{StaticResource CompanyCardTemplate}"/>
                        </ScrollViewer>

                        <TextBlock Text="No Tally or cloud companies found yet. Open Tally or click Refresh."
                                   Foreground="#64748B" FontSize="12.5"
                                   Visibility="{Binding HasCompanyCards, Converter={StaticResource InverseBoolConverter}}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Session Records: "
                                   Foreground="#374151" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SyncItems.Count}"
                                   Foreground="#2563EB" FontSize="20" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                <DataGrid ItemsSource="{Binding SyncItems}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          Background="White"
                          BorderThickness="0"
                          RowBackground="White"
                          AlternatingRowBackground="#F9FAFB"
                          GridLinesVisibility="None"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          Margin="0">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F3F4F6"/>
                            <Setter Property="Foreground" Value="#374151"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="BorderBrush" Value="#E5E7EB"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="BorderBrush" Value="#F3F4F6"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="MinHeight" Value="42"/>
                            <Setter Property="Background" Value="White"/>
                            <Style.Triggers>
                                <Trigger Property="AlternationIndex" Value="1">
                                    <Setter Property="Background" Value="#F9FAFB"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Status" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatusIcon}"
                                               HorizontalAlignment="Center"
                                               FontSize="16"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Item Name" Binding="{Binding Name}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Margin" Value="4,2"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120"/>

                        <DataGridTemplateColumn Header="Result" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,2">
                                        <TextBlock Text="{Binding Status}"
                                                   Foreground="{Binding IsSuccess, Converter={StaticResource BoolToColorConverter}}"
                                                   FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Text="{Binding Error}"
                                                   Foreground="#EF4444"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding Error, Converter={StaticResource NullToVisibilityConverter}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Time"
                                            Binding="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"
                                            Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
                </Border>
            </Grid>

            <!-- SETTINGS PANEL -->
            <ScrollViewer x:Name="SettingsPanel"
                          Grid.Row="1"
                          Visibility="Collapsed"
                          Background="#F5F7FA">
                <StackPanel Margin="24,20,24,24" MaxWidth="740">
                    <!-- Tally Configuration -->
                    <TextBlock Text="Tally Configuration"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="#0F172A"
                               Margin="0,0,0,10"/>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Host (ODBC Server IP)"
                                       Foreground="#374151"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>
                            <TextBox Text="{Binding Settings.TallySettings.Host}"
                                     Style="{StaticResource ModernTextBox}"
                                     Margin="0,0,0,16"/>

                            <TextBlock Text="Port (Default: 9000)"
                                       Foreground="#374151"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>
                            <TextBox Text="{Binding Settings.TallySettings.Port}"
                                     Style="{StaticResource ModernTextBox}"
                                     Margin="0,0,0,16"/>

                            <Button Command="{Binding TestConnectionCommand}"
                                    Content="Test Connection"
                                    Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Left"
                                    Height="38"
                                    Padding="20,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Cloud Sync Configuration -->
                    <TextBlock Text="Cloud Sync Configuration"
                               FontSize="16" FontWeight="Bold"
                               Foreground="#1F2937"
                               Margin="0,0,0,12"/>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="API Endpoint URL"
                                       Foreground="#374151"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>
                            <TextBox Text="{Binding Settings.SyncSettings.ApiBaseUrl}"
                                     Style="{StaticResource ModernTextBox}"
                                     Margin="0,0,0,16"/>

                            <TextBlock Text="Company API Key"
                                       Foreground="#374151"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>
                            <TextBox Text="{Binding Settings.SyncSettings.ApiKey}"
                                     Style="{StaticResource ModernTextBox}"
                                     Margin="0,0,0,16"/>

                            <TextBlock Text="Sync Interval (Minutes)"
                                       Foreground="#374151"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>
                            <TextBox Text="{Binding Settings.SyncSettings.SyncIntervalMinutes}"
                                     Style="{StaticResource ModernTextBox}"
                                     Margin="0,0,0,8"/>

                            <TextBlock Text="Voucher reconciliation (takes effect on next cycle)" Foreground="#374151" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Button Command="{Binding ToggleVoucherReconciliationCommand}" Content="{Binding VoucherReconciliationModeText}" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Height="38" Padding="12,0" Margin="0,0,0,12"/>
                            <Button Command="{Binding SaveSettingsCommand}"
                                    Content="Save Settings"
                                    Style="{StaticResource ModernButton}"
                                    HorizontalAlignment="Left"
                                    Height="40"
                                    Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- WhatsApp QR Notifications -->
                    <TextBlock Text="WhatsApp Notifications (QR)"
                               FontSize="16" FontWeight="Bold"
                               Foreground="#1F2937"
                               Margin="0,0,0,12"/>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock x:Name="WhatsAppStatusText"
                                       Text="Checking WhatsApp QR helper..."
                                       Foreground="#374151"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="Scan QR once via WhatsApp Linked Devices to receive Sync alerts and Voucher PDFs (same as Telegram). Commands supported in WhatsApp chat: /status, /link email license-key, /help."
                                       Foreground="#6B7280"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>
                            <CheckBox Content="Auto-send new voucher PDF to Party WhatsApp (when party phone is in Tally)"
                                      IsChecked="{Binding Settings.SyncSettings.AutoSendPartyWhatsApp, Mode=TwoWay}"
                                      Foreground="#1F2937"
                                      FontSize="13"
                                      FontWeight="SemiBold"
                                      Margin="0,0,0,10"/>
                            <TextBlock Text="Party WhatsApp Voucher Types (comma separated)"
                                       Foreground="#374151"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4"/>
                            <TextBox Text="{Binding Settings.SyncSettings.PartyWhatsAppVoucherTypes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}"
                                     Margin="0,0,0,14"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Open WhatsApp QR"
                                        Click="OpenWhatsAppQr_Click"
                                        Style="{StaticResource ModernButton}"
                                        Height="38"
                                        Padding="16,0"
                                        Margin="0,0,10,0"/>
                                <Button Content="Refresh Status"
                                        Click="RefreshWhatsAppStatus_Click"
                                        Style="{StaticResource GhostButton}"
                                        Height="38"
                                        Padding="16,0"
                                        Margin="0,0,10,0"/>
                                <Button Content="Save Settings"
                                        Command="{Binding SaveSettingsCommand}"
                                        Style="{StaticResource GhostButton}"
                                        Height="38"
                                        Padding="16,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- App Updates (Auto-Download + Restart & Update) -->
                    <TextBlock Text="App Updates"
                               FontSize="16" FontWeight="Bold"
                               Foreground="#1F2937"
                               Margin="0,0,0,12"/>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock x:Name="SettingsUpdateStatusText"
                                       Text="Updates download automatically in the background and install on restart."
                                       Foreground="#374151"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="CheckForUpdatesButton"
                                        Content="Check for Updates"
                                        Click="CheckForUpdates_Click"
                                        Style="{StaticResource GhostButton}"
                                        Height="38"
                                        Padding="16,0"
                                        Margin="0,0,10,0"/>
                                <Button x:Name="SettingsRestartUpdateButton"
                                        Content="Restart &amp; Update"
                                        Click="RestartUpdateButton_Click"
                                        Style="{StaticResource ModernButton}"
                                        Visibility="Collapsed"
                                        Height="38"
                                        Padding="16,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- WHATSAPP QR IN-APP BROWSER PANEL (placed outside ScrollViewer to avoid WebView2 airspace clipping) -->
            <Grid x:Name="WhatsAppQrPanel"
                  Grid.Row="1"
                  Visibility="Collapsed"
                  Margin="24,20,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="WhatsAppQrBackButton"
                                    Content="← Back"
                                    Click="CloseWhatsAppQr_Click"
                                    Style="{StaticResource GhostButton}"
                                    Height="36"
                                    Padding="14,0"
                                    Margin="0,0,14,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="WhatsApp QR (In-App Browser)"
                                           FontSize="15" FontWeight="Bold" Foreground="#1F2937"/>
                                <TextBlock x:Name="WhatsAppQrOverlayStatusText"
                                           Text="Starting WhatsApp QR helper..."
                                           FontSize="12" Foreground="#6B7280"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Button Content="Reload QR"
                                    Click="ReloadWhatsAppQr_Click"
                                    Style="{StaticResource GhostButton}"
                                    Height="36"
                                    Padding="14,0"
                                    Margin="0,0,8,0"/>
                            <Button Content="Open External"
                                    Click="OpenWhatsAppQrExternal_Click"
                                    Style="{StaticResource GhostButton}"
                                    Height="36"
                                    Padding="14,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <StackPanel x:Name="WhatsAppQrLoadingPanel"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="24">
                            <TextBlock x:Name="WhatsAppQrLoadingText"
                                       Text="Starting WhatsApp QR helper..."
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="#374151"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="Scan via WhatsApp -> Linked Devices once; session stays saved automatically."
                                       FontSize="12"
                                       Foreground="#6B7280"
                                       TextAlignment="Center"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                        <wv2:WebView2 x:Name="WhatsAppQrWebView"
                                      Visibility="Collapsed"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- HISTORY PANEL -->
            <Grid x:Name="HistoryPanel"
                  Grid.Row="1"
                  Visibility="Collapsed"
                  Margin="24,20,24,20">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCloudHistoryCommand}" Style="{StaticResource ModernButton}" Padding="16,8"/>
                    <TextBlock Text="{Binding CloudDataStatus}" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
                </DockPanel>
                <DataGrid Grid.Row="1" ItemsSource="{Binding CloudSyncHistory}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          Background="White"
                          BorderThickness="0"
                          RowBackground="White"
                          AlternatingRowBackground="#F9FAFB"
                          GridLinesVisibility="None"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F3F4F6"/>
                            <Setter Property="Foreground" Value="#374151"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="BorderBrush" Value="#E5E7EB"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="BorderBrush" Value="#F3F4F6"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="MinHeight" Value="40"/>
                            <Setter Property="Background" Value="White"/>
                            <Style.Triggers>
                                <Trigger Property="AlternationIndex" Value="1">
                                    <Setter Property="Background" Value="#F9FAFB"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Started" Binding="{Binding LocalStartedAt, StringFormat='{}{0:dd MMM yyyy HH:mm:ss}'}" Width="165"/>
                        <DataGridTextColumn Header="Company" Binding="{Binding CompanyName}" Width="130"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding SyncType}" Width="90"/>
                        <DataGridTextColumn Header="Records" Binding="{Binding RecordsSynced, StringFormat=N0}" Width="80"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                        <DataGridTextColumn Header="Duration" Binding="{Binding DurationText}" Width="90"/>
                        <DataGridTextColumn Header="Details" Binding="{Binding Error}" Width="*" MinWidth="180"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- ===== LICENSE HISTORY PANEL ===== -->
            <Grid x:Name="LicenseHistoryPanel"
                  Grid.Row="1"
                  Visibility="Collapsed"
                  Margin="24,20,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Licence History"
                                   Foreground="#1F2937" FontSize="16" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding LicenseHistory.Count, StringFormat='({0} records)'}"
                                   Foreground="#6B7280" FontSize="12"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding LicenseHistory}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          Background="White"
                          BorderThickness="0"
                          RowBackground="White"
                          AlternatingRowBackground="#F9FAFB"
                          GridLinesVisibility="None"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F3F4F6"/>
                            <Setter Property="Foreground" Value="#374151"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="BorderBrush" Value="#E5E7EB"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="BorderBrush" Value="#F3F4F6"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="MinHeight" Value="44"/>
                            <Setter Property="Background" Value="White"/>
                            <Style.Triggers>
                                <Trigger Property="AlternationIndex" Value="1">
                                    <Setter Property="Background" Value="#F9FAFB"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Event" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Icon}"
                                                   FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="#1F2937" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="{Binding Description}"
                                                       Foreground="#6B7280" FontSize="11"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Date"
                                            Binding="{Binding CreatedAt, StringFormat='{}{0:dd MMM yyyy HH:mm}'}"
                                            Width="170"/>
                        <DataGridTextColumn Header="Plan"
                                            Binding="{Binding PlanName}" Width="120"/>
                        <DataGridTextColumn Header="Status"
                                            Binding="{Binding Status}" Width="100"/>
                        <DataGridTextColumn Header="Expiry"
                                            Binding="{Binding ExpiryDate, StringFormat='{}{0:dd MMM yyyy}'}"
                                            Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- ===== STATUS BAR (Footer) ===== -->
            <Border Grid.Row="2"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,1,0,0">
                <StatusBar Background="White"
                           Height="28">
                <StatusBarItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="● "
                                   Foreground="{Binding Status.IsTallyConnected, Converter={StaticResource BoolToColorConverter}}"
                                   FontSize="10"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Tally"
                                   Foreground="#6B7280" FontSize="11"
                                   Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <TextBlock Text="● "
                                   Foreground="{Binding Status.IsServerConnected, Converter={StaticResource BoolToColorConverter}}"
                                   FontSize="10"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Cloud"
                                   Foreground="#6B7280" FontSize="11"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StatusBarItem>
                <StatusBarItem HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Status.State}"
                               Foreground="#9CA3AF" FontSize="11"/>
                </StatusBarItem>
                </StatusBar>
            </Border>
            <!-- ===== LICENCE BLOCKING OVERLAY (shown when sync is not permitted) ===== -->
            <Grid Grid.RowSpan="3"
                  Visibility="{Binding IsLicenseBlocked, Converter={StaticResource BoolToVisibilityConverter}}"
                  Panel.ZIndex="100">
                <Border Background="#7F000000"/>
                <Border Style="{StaticResource Card}"
                        Width="480"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="32">
                    <Grid Margin="32,28,32,32">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Icon -->
                        <Border Width="64" Height="64"
                                Background="#FEE2E2"
                                CornerRadius="16"
                                Margin="0,0,0,16">
                            <TextBlock Text="🔒" FontSize="28"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- Title -->
                        <TextBlock Grid.Row="1"
                                   Text="{Binding LicenseBlockTitle}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#1F2937"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>

                        <!-- Message -->
                        <TextBlock Grid.Row="2"
                                   Text="{Binding LicenseBlockMessage}"
                                   FontSize="13"
                                   Foreground="#6B7280"
                                   TextWrapping="Wrap"
                                   LineHeight="20"
                                   Margin="0,0,0,16"/>

                        <!-- Contact & free-extension note -->
                        <StackPanel Grid.Row="3" Margin="0,0,0,20">
                            <TextBlock Text="📞 Contact Support"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2937"
                                       Margin="0,0,0,6"/>
                            <TextBlock TextWrapping="Wrap"
                                       LineHeight="18"
                                       Foreground="#6B7280"
                                       FontSize="12">
                                            <Run Text="Admin: "/>
                                            <Run Text="{Binding LicenseResult.SupportName}"/>
                                            <LineBreak/>
                                            <Run Text="Phone: "/>
                                            <Run Text="{Binding LicenseResult.SupportPhone}"/>
                                            <LineBreak/>
                                            <Run Text="Email: "/>
                                            <Run Text="{Binding LicenseResult.SupportEmail}"/>
                            </TextBlock>
                            <TextBlock Text="💡 Need more time? Request a free trial extension from the admin."
                                       FontSize="11"
                                       Foreground="#9CA3AF"
                                       FontStyle="Italic"
                                       Margin="0,10,0,0"/>
                        </StackPanel>

                        <!-- Action buttons -->
                        <StackPanel Grid.Row="4" Orientation="Vertical" HorizontalAlignment="Right" Margin="0,4,0,0">
                            <Button Command="{Binding RefreshLicenseCommand}"
                                    Content="{Binding LicenseBlockAction}"
                                    Style="{StaticResource ModernButton}"
                                    Background="#DC2626"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Height="36"
                                    Padding="16,0"
                                    Margin="0,0,0,10"/>
                            <Button Content="Buy Licence"
                                    Click="BuyLicence_Click"
                                    Background="#2563EB"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Height="36"
                                    Padding="16,0"
                                    Margin="0,0,0,10"/>
                            <Button Content="Logout"
                                    Click="LogoutButton_Click"
                                    Background="#F3F4F6"
                                    Foreground="#DC2626"
                                    BorderThickness="0"
                                    Height="36"
                                    Padding="16,0"
                                    Margin="0,0,0,10"/>
                            <Button Content="Dismiss"
                                    Style="{StaticResource GhostButton}"
                                    Background="#F3F4F6"
                                    Foreground="#374151"
                                    BorderThickness="0"
                                    Height="36"
                                    Padding="16,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</Window>
