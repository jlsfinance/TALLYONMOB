<Window x:Class="TallySyncApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TallySyncApp.ViewModels"
        mc:Ignorable="d"
        Title="TallyLink" Height="650" Width="950"
        Icon="pack://application:,,,/tallylink_logo.png"
        FontFamily="Segoe UI" Background="#F1F5F9"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Window.Resources>
        <local:BoolToColorConverter x:Key="BoolToColorConverter" xmlns:local="clr-namespace:TallySyncApp"/>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter" xmlns:local="clr-namespace:TallySyncApp"/>
        <local:CountToVisibilityConverter x:Key="CountToVisibilityConverter" xmlns:local="clr-namespace:TallySyncApp"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" xmlns:local="clr-namespace:TallySyncApp"/>
        <local:StringToBrushConverter x:Key="StringToBrushConverter" xmlns:local="clr-namespace:TallySyncApp"/>
        <local:ValidationSeverityConverter x:Key="ValidationSeverityConverter" xmlns:local="clr-namespace:TallySyncApp"/>

        <!-- Button Style -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E3A5F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2D5A8E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#B91C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#047857"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WarningBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#D97706"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#B45309"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card Style -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="1" Color="#000" Opacity="0.06" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab Item Style -->
        <Style x:Key="TabBtn" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="Tabs"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E3A5F"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Input Style -->
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#0F172A">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Margin="20,24,20,30" HorizontalAlignment="Center">
                    <Border Width="44" Height="44" Background="#1E3A5F" CornerRadius="12" HorizontalAlignment="Center">
                        <Image Source="pack://application:,,,/tallylink_logo.png" Margin="8" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="TallyLink" Foreground="White" FontSize="17" FontWeight="Bold" 
                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    <TextBlock Text="{Binding Status.CompanyName, FallbackValue=''}" Foreground="#64748B" 
                               FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Nav Items -->
                <StackPanel Grid.Row="1" Margin="12,0">
                    <RadioButton x:Name="NavDashboard" Style="{StaticResource TabBtn}" IsChecked="True" Margin="0,0,0,4"
                                 Checked="NavDashboard_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavLive" Style="{StaticResource TabBtn}" Margin="0,0,0,4"
                                 Checked="NavLive_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Live Status" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource TabBtn}" Margin="0,0,0,4"
                                 Checked="NavSettings_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavHistory" Style="{StaticResource TabBtn}" Margin="0,0,0,4"
                                 Checked="NavHistory_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="History" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- User Panel -->
                <Border Grid.Row="2" Background="#1E293B" Margin="12,0,12,12" Padding="12" CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserEmail, FallbackValue='User'}" Foreground="#CBD5E1" FontSize="11" 
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="130"/>
                            <TextBlock Text="{Binding LicensePlan}" Foreground="#64748B" FontSize="10"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Logout" Click="LogoutButton_Click"
                                Background="#374151" Foreground="#94A3B8" BorderThickness="0"
                                Padding="8,4" FontSize="10" Cursor="Hand" VerticalAlignment="Center">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Bar -->
            <Border Grid.Row="0" Background="White" Padding="24,14" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="18" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="{Binding Status.IsTallyConnected, Converter={StaticResource BoolToColorConverter}}" 
                                CornerRadius="20" Padding="12,5" Margin="0,0,8,0">
                            <TextBlock Text="Tally" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <Border Background="{Binding Status.IsServerConnected, Converter={StaticResource BoolToColorConverter}}" 
                                CornerRadius="20" Padding="12,5">
                            <TextBlock Text="Cloud" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Page Content -->
            <Grid Grid.Row="1" Margin="0">

                <!-- Dashboard Page -->
                <Grid x:Name="DashboardPage" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Stale Sync Alert Banner -->
                    <Border Grid.Row="0" Background="#FEF2F2" BorderBrush="#DC2626" BorderThickness="0,0,0,2" 
                            Padding="16,12" Visibility="{Binding IsSyncCritical, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Pulsing red dot -->
                            <Border Grid.Column="0" Width="12" Height="12" Background="#DC2626" CornerRadius="6" 
                                    VerticalAlignment="Center" Margin="0,0,12,0">
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                                                                 From="1" To="0.3" Duration="0:0:1"
                                                                 AutoReverse="True"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="SYNC OVERDUE" FontWeight="Bold" FontSize="13" Foreground="#DC2626"/>
                                <TextBlock Text="{Binding SyncStalenessText}" Foreground="#991B1B" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <Button Grid.Column="2" Content="Sync Now" Command="{Binding ManualSyncCommand}"
                                    Background="#DC2626" Foreground="White" Padding="16,8" FontSize="12" FontWeight="SemiBold"
                                    Cursor="Hand" BorderThickness="0" VerticalAlignment="Center">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Delayed Sync Warning Banner (amber) -->
                    <Border Grid.Row="0" Background="#FFFBEB" BorderBrush="#D97706" BorderThickness="0,0,0,2" 
                            Padding="16,12" Visibility="{Binding IsSyncDelayed, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="⚠" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="SYNC DELAYED" FontWeight="Bold" FontSize="13" Foreground="#D97706"/>
                                <TextBlock Text="{Binding SyncStalenessText}" Foreground="#92400E" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <Button Grid.Column="2" Content="Sync Now" Command="{Binding ManualSyncCommand}"
                                    Background="#D97706" Foreground="White" Padding="16,8" FontSize="12" FontWeight="SemiBold"
                                    Cursor="Hand" BorderThickness="0" VerticalAlignment="Center">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Status Card -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="16,16,16,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="SYNC STATUS" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Status.StatusText}" FontSize="28" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="{Binding Status.Message}" Foreground="#64748B" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>

                                <Grid Margin="0,16,0,0">
                                    <ProgressBar Height="6" Minimum="0" Maximum="100" 
                                                 Value="{Binding Status.ProgressPercentage, Mode=OneWay, FallbackValue=0}" 
                                                 Foreground="#1E3A5F" Background="#E2E8F0" BorderThickness="0"/>
                                    <ProgressBar Height="6" Minimum="0" Maximum="100" 
                                                 Value="{Binding Status.ProgressPercentage, Mode=OneWay, FallbackValue=0}" 
                                                 Foreground="#1E3A5F" Background="Transparent" BorderThickness="0"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                                <Button Command="{Binding StartSyncCommand}" Content="Start Auto-Sync" Style="{StaticResource PrimaryBtn}" Margin="0,0,0,8"/>
                                <Button Command="{Binding StopSyncCommand}" Content="Stop Sync" Style="{StaticResource DangerBtn}" Margin="0,0,0,8"/>
                                <Button Command="{Binding ManualSyncCommand}" Content="Sync Now" Style="{StaticResource SuccessBtn}" Margin="0,0,0,8"/>
                                <Button Command="{Binding ForceResyncCommand}" Content="Force Full Resync" Style="{StaticResource WarningBtn}" Margin="0,0,0,8"/>
                                <Button Command="{Binding ExportReportCommand}" Content="Export Report" Style="{StaticResource PrimaryBtn}" Margin="0,0,0,8"/>
                                <Button Command="{Binding RunValidationCommand}" Content="Run Validation" Style="{StaticResource PrimaryBtn}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Stats Cards -->
                    <Grid Grid.Row="2" Margin="8,8,8,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}" BorderBrush="{Binding LastSyncBorderColor, Converter={StaticResource StringToBrushConverter}}" BorderThickness="2">
                            <StackPanel>
                                <TextBlock Text="LAST SYNC" Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBlock FontSize="20" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{Binding LastSyncColor, Converter={StaticResource StringToBrushConverter}}"/>
                                            <Setter Property="Text" Value="{Binding Status.LastSyncTime, StringFormat='{}{0:HH:mm:ss}'}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status.LastSyncTime}" Value="{x:Null}">
                                                    <Setter Property="Text" Value="--:--:--"/>
                                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock FontSize="11" Margin="0,2,0,0" Foreground="#94A3B8">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status.LastSyncTime}" Value="{x:Null}">
                                                    <Setter Property="Text" Value="Never synced"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                            <Setter Property="Text" Value="{Binding Status.LastSyncTime, StringFormat='{}{0:dd MMM yyyy}'}"/>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="NEXT SCHEDULE" Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBlock FontSize="20" FontWeight="Bold" Foreground="#0F172A">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status.NextSyncTime}" Value="{x:Null}">
                                                    <Setter Property="Text" Value="--:--:--"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                            <Setter Property="Text" Value="{Binding Status.NextSyncTime, StringFormat='{}{0:HH:mm:ss}'}"/>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Settings.SyncSettings.SyncIntervalMinutes, StringFormat='Every {0} min'}" Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="RECORDS" Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding Status.ProcessedRecords}" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="processed this session" Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="LICENSE" Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding LicensePlan}" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="{Binding LicenseStatus}" Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding LicenseDaysRemaining, StringFormat='{}{0} days left'}" Foreground="#059669" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Live Logs -->
                    <Border Grid.Row="3" Background="#0F172A" CornerRadius="12" Margin="16,8,16,16" Padding="16">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                                <Button Content="Copy Logs" Command="{Binding CopyLogsCommand}"
                                        Padding="14,5" Background="#1E3A5F" Foreground="#CBD5E1" 
                                        FontSize="11" FontWeight="SemiBold" Cursor="Hand" BorderThickness="0" Margin="0,0,6,0">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <Button Content="Clear" Command="{Binding ClearLogsCommand}"
                                        Padding="14,5" Background="#334155" Foreground="#94A3B8" 
                                        FontSize="11" Cursor="Hand" BorderThickness="0">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding ConsoleOutput}" FontFamily="Cascadia Code,Consolas" Foreground="#CBD5E1" 
                                           FontSize="11" TextWrapping="Wrap" LineHeight="18"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- Live Status Page -->
                <Grid x:Name="LivePage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="16,16,16,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Records synced this session:" Foreground="#64748B" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SyncItems.Count}" FontWeight="Bold" Foreground="#1E3A5F" FontSize="16" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Empty state message -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="16,8,16,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DataGrid Grid.Row="0" ItemsSource="{Binding SyncItems}" AutoGenerateColumns="False" 
                                      CanUserAddRows="False" IsReadOnly="True"
                                      GridLinesVisibility="None"
                                      Background="White" BorderThickness="0" RowBackground="White" AlternatingRowBackground="#F8FAFC"
                                      BorderBrush="#E2E8F0" HeadersVisibility="None">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#F1F5F9"/>
                                        <Setter Property="Foreground" Value="#64748B"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="Padding" Value="12,8"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Status" Width="50">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StatusIcon}" HorizontalAlignment="Center" FontSize="14"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="280">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="Margin" Value="8,4"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="Margin" Value="8,4"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    
                                    <DataGridTemplateColumn Header="Result" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="8,4">
                                                    <TextBlock Text="{Binding Status}" 
                                                               Foreground="{Binding IsSuccess, Converter={StaticResource BoolToColorConverter}}" 
                                                               FontWeight="SemiBold" FontSize="12"/>
                                                    <TextBlock Text="{Binding Error}" 
                                                               Foreground="#EF4444" FontSize="11" TextWrapping="Wrap"
                                                               Visibility="{Binding Error, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    
                                    <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" Width="90">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#94A3B8"/>
                                                <Setter Property="FontSize" Value="11"/>
                                                <Setter Property="Margin" Value="8,4"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Empty state overlay -->
                            <Border Grid.Row="0" Background="White" CornerRadius="12" 
                                    Visibility="{Binding SyncItems.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                                    <TextBlock Text="No records synced yet" FontSize="16" FontWeight="SemiBold" 
                                               Foreground="#64748B" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Start a sync from the Dashboard to see live updates here" 
                                               Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Settings Page -->
                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed">
                    <StackPanel Margin="16">
                        <!-- Tally Config -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Tally Configuration" FontWeight="Bold" FontSize="15" Foreground="#0F172A" Margin="0,0,0,16"/>

                                <TextBlock Text="Host (ODBC Server IP)" Foreground="#64748B" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding Settings.TallySettings.Host}" Style="{StaticResource InputField}" Margin="0,0,0,14"/>

                                <TextBlock Text="Port (Default: 9000)" Foreground="#64748B" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding Settings.TallySettings.Port}" Style="{StaticResource InputField}" Margin="0,0,0,14"/>

                                <Button Command="{Binding TestConnectionCommand}" Content="Test Tally Connection" Style="{StaticResource PrimaryBtn}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <!-- Cloud Config -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Cloud Configuration" FontWeight="Bold" FontSize="15" Foreground="#0F172A" Margin="0,0,0,16"/>

                                <TextBlock Text="API Endpoint" Foreground="#64748B" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding Settings.SyncSettings.ApiBaseUrl}" Style="{StaticResource InputField}" Margin="0,0,0,14"/>

                                <TextBlock Text="API Key" Foreground="#64748B" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding Settings.SyncSettings.ApiKey}" Style="{StaticResource InputField}" Margin="0,0,0,14"/>

                                <TextBlock Text="Sync Interval (minutes)" Foreground="#64748B" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding Settings.SyncSettings.SyncIntervalMinutes}" Style="{StaticResource InputField}" Margin="0,0,0,14"/>

                                <Button Command="{Binding SaveSettingsCommand}" Content="Save Settings" Style="{StaticResource SuccessBtn}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <!-- License -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="License" FontWeight="Bold" FontSize="15" Foreground="#0F172A" Margin="0,0,0,16"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="PLAN" Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding LicensePlan}" FontWeight="Bold" FontSize="18" Foreground="#0F172A"/>

                                        <TextBlock Text="STATUS" Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold" Margin="0,16,0,4"/>
                                        <TextBlock Text="{Binding LicenseStatus}" FontWeight="SemiBold" FontSize="14" Foreground="#059669"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="DAYS REMAINING" Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBlock FontSize="28" FontWeight="Bold">
                                            <Run Text="{Binding LicenseDaysRemaining}" Foreground="#1E3A5F"/>
                                            <Run Text=" days" FontSize="14" Foreground="#94A3B8"/>
                                        </TextBlock>

                                        <TextBlock Text="TALLY SERIAL" Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold" Margin="0,12,0,4"/>
                                        <TextBlock Text="{Binding Settings.TallySettings.SerialNumber, FallbackValue='Not bound yet'}" 
                                                   FontFamily="Cascadia Code,Consolas" FontSize="12" Foreground="#334155"/>
                                    </StackPanel>
                                </Grid>

                                <Button Command="{Binding ValidateLicenseCommand}" Content="Validate License" 
                                        Style="{StaticResource PrimaryBtn}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Auto-Start -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Startup" FontWeight="Bold" FontSize="15" Foreground="#0F172A" Margin="0,0,0,16"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Auto-Start with Windows" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A"/>
                                        <TextBlock Text="{Binding AutoStartStatusText}" Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Command="{Binding ToggleAutoStartCommand}" Cursor="Hand" Padding="16,6"
                                            FontSize="12" FontWeight="SemiBold" BorderThickness="0" VerticalAlignment="Center">
                                        <Button.Content>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Enable"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAutoStartEnabled}" Value="True">
                                                                <Setter Property="Text" Value="Disable"/>
                                                                <Setter Property="Foreground" Value="#0F172A"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button.Content>
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" Background="#1E3A5F" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding IsAutoStartEnabled}" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                                                                </DataTrigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Bandwidth Usage -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Bandwidth Usage" FontWeight="Bold" FontSize="15" Foreground="#0F172A" Margin="0,0,0,16"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    
                                    <StackPanel Grid.Row="0">
                                        <TextBlock Text="UPLOADED" Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Bandwidth.TotalUploadedFormatted}" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1">
                                        <TextBlock Text="DOWNLOADED" Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Bandwidth.TotalDownloadedFormatted}" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                        <TextBlock Text="SESSION UPLOAD" Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Bandwidth.SessionUploadedFormatted}" FontSize="14" FontWeight="SemiBold" Foreground="#1E3A5F"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,12,0,0">
                                        <TextBlock Text="SESSION DOWNLOAD" Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Bandwidth.SessionDownloadedFormatted}" FontSize="14" FontWeight="SemiBold" Foreground="#1E3A5F"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Data Validation -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Data Validation" FontWeight="Bold" FontSize="15" Foreground="#0F172A"/>
                                        <TextBlock FontSize="12" Margin="0,2,0,0">
                                            <Run Text="{Binding ValidationErrorCount, FallbackValue=0}" Foreground="#DC2626" FontWeight="Bold"/>
                                            <Run Text=" errors" Foreground="#94A3B8"/>
                                            <Run Text=" | " Foreground="#CBD5E1"/>
                                            <Run Text="{Binding ValidationWarningCount, FallbackValue=0}" Foreground="#D97706" FontWeight="Bold"/>
                                            <Run Text=" warnings" Foreground="#94A3B8"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Run" Command="{Binding RunValidationCommand}"
                                            Padding="16,6" Background="#1E3A5F" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                            Cursor="Hand" BorderThickness="0" VerticalAlignment="Center">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>

                                <!-- Validation Issues List -->
                                <ItemsControl ItemsSource="{Binding ValidationIssues}" Margin="0,12,0,0" MaxHeight="200">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,6" CornerRadius="6" Margin="0,2" Background="#F8FAFC">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <Border.Background>
                                                            <Binding Path="Severity" Converter="{StaticResource ValidationSeverityConverter}"/>
                                                        </Border.Background>
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#0F172A">
                                                            <Run Text="{Binding Category, Mode=OneWay}"/>
                                                            <Run Text=" - " Foreground="#94A3B8"/>
                                                            <Run Text="{Binding Entity, Mode=OneWay}" Foreground="#64748B"/>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Message}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- History Page -->
                <DataGrid x:Name="HistoryPage" Visibility="Collapsed"
                          ItemsSource="{Binding RecentLogs}" AutoGenerateColumns="False" 
                          CanUserAddRows="False" IsReadOnly="True" Margin="16"
                          GridLinesVisibility="None" Background="White" BorderThickness="0"
                          HeadersVisibility="None" AlternatingRowBackground="#F8FAFC">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F1F5F9"/>
                            <Setter Property="Foreground" Value="#64748B"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="Padding" Value="12,8"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="160"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding DataType}" Width="120"/>
                        <DataGridTextColumn Header="Records" Binding="{Binding RecordCount}" Width="80"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Success}" Width="80"/>
                        <DataGridTextColumn Header="Duration" Binding="{Binding DurationMs, StringFormat='{}{0}ms'}" Width="100"/>
                        <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Status Bar -->
            <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,6">
                <Grid>
                    <TextBlock Text="Ready" Foreground="#94A3B8" FontSize="11"/>
                    <TextBlock Text="v3.0.0" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
