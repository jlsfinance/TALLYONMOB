<UserControl x:Class="TallySyncApp.Pages.PartyDetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Border Grid.Row="0" Background="#1E3A5F" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="← Back" Click="Back_Click"
                        Background="Transparent" Foreground="White" BorderThickness="0"
                        FontSize="12" FontWeight="SemiBold" Cursor="Hand" Padding="4,4"/>

                <TextBlock Grid.Column="1" x:Name="PartyTitle" Text="" Foreground="White" FontSize="14" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Party Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="#F8FAFC">
            <StackPanel Margin="16">

                <!-- Party Header Card -->
                <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,12"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="56" Height="56" CornerRadius="14" Background="#EEF2FF"
                                VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Text="👤" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="PartyNameText" Text="" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock x:Name="PartyGroupText" Text="" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                            <TextBlock x:Name="PartyGstinText" Text="" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"
                                       FontFamily="Cascadia Code,Consolas"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Contact Info -->
                <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,12"
                        BorderBrush="#E2E8F0" BorderThickness="1" x:Name="ContactBorder">
                    <StackPanel>
                        <TextBlock Text="CONTACT" FontSize="9" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="📱" FontSize="14" Margin="0,0,10,8"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="PhoneText" Text="—" FontSize="12" Foreground="#334155" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="✉" FontSize="14" Margin="0,0,10,8"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="EmailText" Text="—" FontSize="12" Foreground="#334155" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="📍" FontSize="14" Margin="0,0,10,8"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="AddressText" Text="—" FontSize="12" Foreground="#334155" TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="💰" FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="BalanceText" Text="—" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Transactions -->
                <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,12"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="TRANSACTIONS" FontSize="9" FontWeight="SemiBold" Foreground="#94A3B8"/>
                            <TextBlock x:Name="TxnCount" Text="" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Right"/>
                        </Grid>
                        <ItemsControl x:Name="TransactionsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" CornerRadius="8" Padding="12,8" Margin="0,0,0,6"
                                            Cursor="Hand" MouseLeftButtonDown="Transaction_Click"
                                            Tag="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                                    VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding TypeIcon}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#0F172A">
                                                    <Run Text="{Binding VoucherType, Mode=OneWay}"/>
                                                    <Run Text=" #"/>
                                                    <Run Text="{Binding VoucherNumber, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding DateFormatted}" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding AmountFormatted}" FontSize="13" FontWeight="Bold"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NoTransactionsText" Text="No transactions found" FontSize="12"
                                   Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,20,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
