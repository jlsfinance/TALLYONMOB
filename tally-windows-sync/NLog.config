<?xml version="1.0" encoding="utf-8"?>
<!--
  TallyLink logging configuration (NLog 6.x).

  Mirrors the LiveKeeping "Data Connector" layout (see livekeeping-rea/FINDINGS.md section 3):
    * SyncingLogger  -> logs/syncingLogger.log          (sync progress, size based archiving)
    * AppLogger      -> network target, fallback to logs/tdcLog.log        (JSON telemetry)
    * ActivityLogger -> network target, fallback to logs/tdcActivityOffline.log (JSON audit)

  TODO(telemetry endpoint): the two network targets below point at a PLACEHOLDER host
  (telemetry.tallylink.local) which does not exist. Set the TALLYLINK_TELEMETRY_HOST
  environment variable to the real ingestion host before shipping, or change the
  ${environment:...:default=...} values below. Ports follow the competitor's layout:
    5000 = app telemetry over UDP, 5001 = activity/audit over TCP.
  While the placeholder host is unreachable every event falls back to the local file targets,
  so nothing is ever lost.
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      throwConfigExceptions="true">

  <targets async="true">

    <!-- Sync progress log (plain text, one line per entry). -->
    <target name="SyncingLogger" xsi:type="File"
            fileName="${basedir}/logs/syncingLogger.log"
            layout="${longdate} ${message}"
            keepFileOpen="true" concurrentWrites="true"
            archiveAboveSize="1048576" maxArchiveFiles="1" />

    <!-- App telemetry: try the network first, fall back to a local JSON file. -->
    <target name="groupTarget" xsi:type="FallbackGroup" returnToFirstOnSuccess="true">

      <target name="netTarget" xsi:type="Network"
              address="udp://${environment:TALLYLINK_TELEMETRY_HOST:default=telemetry.tallylink.local}:5000"
              newLine="true">
        <layout xsi:type="JsonLayout" IncludeScopeProperties="true">
          <attribute name="systemDateTime" layout="${date:format=O}" />
          <attribute name="functionName" layout="${message}" />
          <attribute name="logger" layout="${logger}" />
          <attribute name="level" layout="${level}" />
          <attribute name="exception" encode="false">
            <layout xsi:type="JsonLayout">
              <attribute name="type" layout="${exception:format=type}" />
              <attribute name="message" layout="${exception:format=message}" />
              <attribute name="stacktrace" layout="${exception:format=tostring}" />
            </layout>
          </attribute>
        </layout>
      </target>

      <target name="fileTarget" xsi:type="File"
              keepFileOpen="false" concurrentWrites="true"
              fileName="${basedir}/logs/tdcLog.log"
              archiveAboveSize="200000" maxArchiveFiles="2">
        <layout xsi:type="JsonLayout" IncludeScopeProperties="true">
          <attribute name="systemDateTime" layout="${date:format=O}" />
          <attribute name="functionName" layout="${message}" />
          <attribute name="logger" layout="${logger}" />
          <attribute name="level" layout="${level}" />
          <attribute name="exception" encode="false">
            <layout xsi:type="JsonLayout">
              <attribute name="type" layout="${exception:format=type}" />
              <attribute name="message" layout="${exception:format=message}" />
              <attribute name="stacktrace" layout="${exception:format=tostring}" />
            </layout>
          </attribute>
        </layout>
      </target>

    </target>

    <!-- Activity / audit events: network first, offline file so nothing is lost while offline. -->
    <target xsi:type="FallbackGroup" name="tcpTargetGroup" returnToFirstOnSuccess="true">

      <target name="tcpTarget" xsi:type="Network"
              address="tcp://${environment:TALLYLINK_TELEMETRY_HOST:default=telemetry.tallylink.local}:5001"
              newLine="true">
        <layout xsi:type="JsonLayout" IncludeScopeProperties="true">
          <attribute name="msg" layout="${event-properties:msg}" />
          <attribute name="_userId" layout="${event-properties:_userId}" />
          <attribute name="description" layout="${event-properties:description}" />
          <attribute name="requestFrom" layout="${event-properties:requestFrom}" />
          <attribute name="createdAt" layout="${event-properties:createdAt}" />
          <attribute name="company_id" layout="${event-properties:company_id}" />
          <attribute name="customerStatus" layout="${event-properties:customerStatus}" />
          <attribute name="customerSource" layout="${event-properties:customerSource}" />
          <attribute name="macAddress" layout="${event-properties:macAddress}" />
          <attribute name="sessionId" layout="${event-properties:sessionId}" />
          <attribute name="desktopVersion" layout="${event-properties:desktopVersion}" />
        </layout>
      </target>

      <target xsi:type="File" name="fileBackup"
              fileName="${basedir}/logs/tdcActivityOffline.log"
              keepFileOpen="false" concurrentWrites="true"
              archiveAboveSize="500000" maxArchiveFiles="2">
        <layout xsi:type="JsonLayout" IncludeScopeProperties="true">
          <attribute name="msg" layout="${event-properties:msg}" />
          <attribute name="_userId" layout="${event-properties:_userId}" />
          <attribute name="description" layout="${event-properties:description}" />
          <attribute name="requestFrom" layout="${event-properties:requestFrom}" />
          <attribute name="createdAt" layout="${event-properties:createdAt}" />
          <attribute name="company_id" layout="${event-properties:company_id}" />
          <attribute name="customerStatus" layout="${event-properties:customerStatus}" />
          <attribute name="customerSource" layout="${event-properties:customerSource}" />
          <attribute name="macAddress" layout="${event-properties:macAddress}" />
          <attribute name="sessionId" layout="${event-properties:sessionId}" />
          <attribute name="desktopVersion" layout="${event-properties:desktopVersion}" />
        </layout>
      </target>

    </target>

  </targets>

  <rules>
    <logger name="SyncingLogger" minlevel="Info" writeTo="SyncingLogger" />
    <logger name="AppLogger" minlevel="Trace" writeTo="groupTarget" />
    <logger name="ActivityLogger" minlevel="Info" writeTo="tcpTargetGroup" />
  </rules>

</nlog>
