<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <SupportedOSPlatform>windows</SupportedOSPlatform>
    <ApplicationIcon>app_icon.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <AssemblyName>TallyLink</AssemblyName>
    <!-- Distinguish local debug builds without changing the installed release identity. -->
    <AssemblyName Condition="'$(Configuration)' == 'Debug'">Syncora</AssemblyName>
    <RootNamespace>TallySyncApp</RootNamespace>
    <Version>2.0.9</Version>
    <Authors>TallySync</Authors>
    <Company>TallySync</Company>
    <Product>TallySync - Tally Data Sync</Product>
    <Description>Sync Tally ERP data to cloud for mobile access</Description>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="tallylink_logo.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Clowd.Squirrel" Version="2.11.1" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Microsoft.AspNet.SignalR.Client" Version="2.4.3" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <PackageReference Include="MongoDB.Bson" Version="3.12.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
    <PackageReference Include="NLog" Version="6.2.2" />
    <PackageReference Include="System.Management" Version="10.0.13" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="NLog.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Remove="app_icon.ico" />
    <Resource Include="app_icon.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <!-- Exclude TallySyncApp subfolder to avoid conflicts -->
  <ItemGroup>
    <Compile Remove="TallySyncApp\**" />
    <Page Remove="TallySyncApp\**" />
    <EmbeddedResource Remove="TallySyncApp\**" />
    <None Remove="TallySyncApp\**" />
  </ItemGroup>

</Project>
