<Window x:Class="TallySyncApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SYNCORA" Height="520" Width="400"
        Icon="pack://application:,,,/tallylink_logo.png"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="180"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#1E3A5F" Grid.Row="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,25">
                    <Border Width="60" Height="60" Background="White" CornerRadius="16" HorizontalAlignment="Center">
                        <Image Source="pack://application:,,,/tallylink_logo.png" Margin="10" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <TextBlock Text="SYNCORA" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Cloud Sync for Tally" Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,30,40,20">
                <TextBlock x:Name="HeaderText" Text="Sign In" FontSize="20" FontWeight="Bold" 
                           Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock x:Name="SubHeaderText" Text="Enter your credentials to continue" Foreground="#64748B" 
                           FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,28"/>

                <StackPanel x:Name="FullNamePanel" Visibility="Collapsed" Margin="0,0,0,14">
                    <TextBlock Text="Full Name" Foreground="#334155" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                    <TextBox x:Name="FullNameBox" Height="40" Padding="12,10" FontSize="13"
                             BorderBrush="#CBD5E1" BorderThickness="1" Background="#F8FAFC">
                        <TextBox.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                        </TextBox.Resources>
                    </TextBox>
                </StackPanel>

                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Email Address" Foreground="#334155" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                    <TextBox x:Name="EmailBox" Height="40" Padding="12,10" FontSize="13"
                             BorderBrush="#CBD5E1" BorderThickness="1" Background="#F8FAFC">
                        <TextBox.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                        </TextBox.Resources>
                    </TextBox>
                </StackPanel>

                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="Password" Foreground="#334155" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="PasswordBox" Height="40" Padding="12,10" FontSize="13"
                                 BorderBrush="#CBD5E1" BorderThickness="1" Background="#F8FAFC">
                        <PasswordBox.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                        </PasswordBox.Resources>
                    </PasswordBox>
                </StackPanel>

                <TextBlock x:Name="ErrorText" Foreground="#EF4444" FontSize="11" TextWrapping="Wrap"
                           Margin="0,0,0,10" Visibility="Collapsed"/>

                <Button x:Name="LoginButton" Height="44" Click="LoginButton_Click"
                        Background="#1E3A5F" Foreground="White" FontWeight="SemiBold" FontSize="13"
                        BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ButtonIcon" Text="" Margin="0,0,8,0"/>
                        <TextBlock x:Name="ButtonText" Text="Sign In"/>
                    </StackPanel>
                </Button>

                <StackPanel x:Name="LoadingPanel" Orientation="Horizontal" HorizontalAlignment="Center" 
                            Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBlock Text="Signing in..." Foreground="#64748B" FontSize="12"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <TextBlock x:Name="TogglePrompt" Text="Don't have an account? " Foreground="#64748B" FontSize="12"/>
                    <TextBlock x:Name="ToggleLink" Text="Sign Up" Foreground="#1E3A5F" FontWeight="SemiBold" 
                               FontSize="12" Cursor="Hand" MouseDown="ToggleMode_Click">
                        <TextBlock.TextDecorations><TextDecoration Location="Underline"/></TextBlock.TextDecorations>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
