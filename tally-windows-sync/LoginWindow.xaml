<Window x:Class="TallySyncApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SYNCORA Connector - Sign In" Height="700" Width="500"
        Icon="app_icon.ico"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MinHeight="600" MinWidth="440">

    <Window.Resources>
        <Storyboard x:Key="FloatingAnimation" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="0" To="-8" Duration="0:0:2.5">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="SpinnerAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="0" To="360" Duration="0:0:1.2" />
        </Storyboard>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalContentAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalContentAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Outer rounded border with gradient -->
        <Border CornerRadius="24" Background="#0B8968" BorderThickness="0">
            <Border.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0B8968" Offset="0.0"/>
                    <GradientStop Color="#075E4B" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.OpacityMask>
        </Border>

        <!-- Secondary border layer -->
        <Border CornerRadius="24" Background="#0B8968" BorderThickness="0" Margin="2">
            <Border.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0B8968" Offset="0.0"/>
                    <GradientStop Color="#075E4B" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.OpacityMask>
        </Border>

        <!-- Main white card -->
        <Border CornerRadius="24" Margin="4">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="15" Color="#000000" Opacity="0.35"/>
            </Border.Effect>
            <Border Background="#FFFFFF" CornerRadius="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- LOGO AREA -->
                    <StackPanel Margin="0,36,0,16" HorizontalAlignment="Center">
                        <Border Width="80" Height="80"
                                Background="#050A17"
                                CornerRadius="24"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform/>
                            </Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Border.Loaded">
                                    <BeginStoryboard Storyboard="{StaticResource FloatingAnimation}"/>
                                </EventTrigger>
                            </Border.Triggers>
                            <Image Source="syncora-connector.png" Stretch="UniformToFill"/>
                        </Border>

                        <TextBlock Text="SYNCORA" Foreground="#1F2937" FontSize="28"
                                   FontWeight="Bold" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                        <TextBlock Text="Tally sync for your business"
                                   Foreground="#6B7280" FontSize="12"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        <TextBlock x:Name="VersionText" Text="v3.1.6"
                                   Foreground="#9CA3AF" FontSize="11"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- LOGIN CARD -->
                    <Border Grid.Row="1" Margin="32,0,32,32">
                        <StackPanel>

                            <!-- Header -->
                            <TextBlock x:Name="HeaderText" Text="Welcome Back"
                                       Foreground="#1F2937" FontSize="26" FontWeight="Bold"
                                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock x:Name="SubHeaderText" Text="Sign in to your account"
                                       Foreground="#6B7280" FontSize="14"
                                       HorizontalAlignment="Center" Margin="0,0,0,32"/>

                            <!-- Full Name (signup only) -->
                            <StackPanel x:Name="FullNamePanel" Visibility="Collapsed" Margin="0,0,0,16">
                                <TextBlock Text="Full Name"
                                           Foreground="#374151"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Margin="0,0,0,6"/>
                                <TextBox x:Name="FullNameBox"
                                         Style="{StaticResource ModernTextBox}"
                                         Tag="John Doe"/>
                            </StackPanel>

                            <!-- Email -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Email Address"
                                           Foreground="#374151"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Margin="0,0,0,6"/>
                                <TextBox x:Name="EmailBox"
                                         Style="{StaticResource ModernTextBox}"
                                         Tag="you@example.com"/>
                            </StackPanel>

                            <!-- Password -->
                            <StackPanel Margin="0,0,0,20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Password"
                                               Foreground="#374151"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Margin="0,0,0,6"/>
                                </Grid>
                                <PasswordBox x:Name="PasswordBox"
                                             Style="{StaticResource ModernPasswordBox}"/>
                            </StackPanel>

                            <!-- Error Message -->
                            <Border x:Name="ErrorBorder"
                                    Background="#FEF2F2"
                                    CornerRadius="10"
                                    Padding="12,12"
                                    Margin="0,0,0,16"
                                    Visibility="Collapsed"
                                    BorderBrush="#FECACA"
                                    BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚠" FontSize="14" Margin="0,0,10,0" Foreground="#EF4444"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ErrorText"
                                               Foreground="#DC2626" FontSize="13"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Login Button -->
                            <Button x:Name="LoginButton"
                                    Click="LoginButton_Click"
                                    Height="52"
                                    Style="{StaticResource ModernButton}"
                                    FontSize="16" FontWeight="SemiBold"
                                    Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock x:Name="ButtonIcon" Text="" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="ButtonText" Text="Sign In"/>
                                </StackPanel>
                            </Button>

                            <!-- Loading Spinner -->
                            <StackPanel x:Name="LoadingPanel"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,16"
                                        Visibility="Collapsed">
                                <Border Width="20" Height="20"
                                        Background="Transparent"
                                        RenderTransformOrigin="0.5,0.5"
                                        Margin="0,0,10,0">
                                    <Border.RenderTransform>
                                        <RotateTransform/>
                                    </Border.RenderTransform>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Border.Loaded">
                                            <BeginStoryboard Storyboard="{StaticResource SpinnerAnimation}"/>
                                        </EventTrigger>
                                    </Border.Triggers>
                                    <Grid>
                                        <Ellipse Width="20" Height="20"
                                                 Stroke="#E5E7EB" StrokeThickness="2.5"/>
                                        <Ellipse Width="20" Height="20"
                                                 Stroke="#0B8968" StrokeThickness="2.5"
                                                 StrokeDashArray="25,50"
                                                 RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform>
                                                <RotateTransform Angle="-90"/>
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="LoadingText"
                                           Text="Signing in..."
                                           Foreground="#6B7280" FontSize="13"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Divider -->
                            <Border Margin="0,20,0,0"
                                    Height="1"
                                    Background="#E5E7EB"/>
                            <TextBlock Text="Or sign in with"
                                       Foreground="#9CA3AF"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,16"/>

                            <!-- Google Button -->
                            <Button x:Name="GoogleLoginButton"
                                    Click="GoogleLoginButton_Click"
                                    Height="52"
                                    Style="{StaticResource ModernButton}"
                                    Background="#FFFFFF"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    Foreground="#374151"
                                    FontSize="15">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="G" Margin="0,0,12,0"
                                               FontSize="18"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="Continue with Google"/>
                                </StackPanel>
                            </Button>

                            <!-- Toggle Login/Signup -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,24,0,0">
                                <TextBlock x:Name="TogglePrompt"
                                           Text="Don't have an account? "
                                           Foreground="#6B7280" FontSize="13"/>
                                <TextBlock x:Name="ToggleLink"
                                           Text="Sign Up"
                                           Foreground="#0B8968" FontWeight="SemiBold"
                                           FontSize="13" Cursor="Hand"
                                           MouseDown="ToggleMode_Click">
                                    <TextBlock.TextDecorations>
                                        <TextDecoration Location="Underline"/>
                                    </TextBlock.TextDecorations>
                                </TextBlock>
                            </StackPanel>

                            <!-- Debug Log Panel -->
                            <Border x:Name="LogPanel"
                                    Background="#1F2937"
                                    CornerRadius="12"
                                    Margin="0,24,0,0"
                                    Padding="10"
                                    Visibility="Visible">
                                <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto">
                                    <TextBox x:Name="LogTextBox"
                                             Background="Transparent"
                                             Foreground="#10B981"
                                             FontFamily="Consolas"
                                             FontSize="9"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             BorderThickness="0"/>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>