<Window x:Class="TallySyncApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TallyLink - Login" Height="570" Width="420"
        Icon="pack://application:,,,/tallylink_logo.png"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI">

    <Window.Background>
        <RadialGradientBrush Center="0.5,0.0" RadiusX="0.9" RadiusY="0.9">
            <GradientStop Color="#1E293B" Offset="0"/>
            <GradientStop Color="#0A0C10" Offset="1"/>
        </RadialGradientBrush>
    </Window.Background>

    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#22D3EE"/>
            <Setter Property="Foreground" Value="#09090B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="#22D3EE"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0"
                                CornerRadius="12" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#22D3EE" Opacity="0.2"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#22D3EE" Opacity="0.4"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#06B6D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Logo Area -->
        <StackPanel Margin="40,30,40,15" HorizontalAlignment="Center">
            <Border Width="70" Height="70" Background="#18181B" BorderBrush="#27272A" BorderThickness="1.5" CornerRadius="18">
                <Image Source="pack://application:,,,/tallylink_logo.png" Margin="12" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <TextBlock HorizontalAlignment="Center" Margin="0,15,0,0">
                <Run Text="Tally" Foreground="#FAFAFA" FontWeight="Bold" FontSize="26"/>
                <Run Text="Link" Foreground="#22D3EE" FontWeight="Bold" FontSize="26"/>
            </TextBlock>
            <TextBlock Text="Tally Cloud Sync Desktop App" Foreground="#71717A" FontSize="11" 
                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Login Card -->
        <Border Grid.Row="1" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="20" Padding="30,25" Margin="20,5,20,20">
            <StackPanel>
                <!-- Toggle: Login / Signup -->
                <TextBlock x:Name="HeaderText" Text="Welcome Back" FontSize="20" FontWeight="Bold" 
                           Foreground="#FAFAFA" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock x:Name="SubHeaderText" Text="Sign in to your account" Foreground="#71717A" 
                           FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <!-- Full Name (only for signup) -->
                <StackPanel x:Name="FullNamePanel" Visibility="Collapsed" Margin="0,0,0,12">
                    <TextBlock Text="Full Name" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="FullNameBox" Height="40" Padding="12,8" FontSize="14"
                             InputMethod.IsInputMethodEnabled="False"/>
                </StackPanel>

                <!-- Email -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Email Address" Foreground="#A1A1AA" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="EmailBox" Height="40" Padding="12,8" FontSize="14" Background="#27272A" Foreground="#FAFAFA" BorderBrush="#3F3F46"
                             InputMethod.IsInputMethodEnabled="False"/>
                </StackPanel>

                <!-- Password -->
                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Password" Foreground="#A1A1AA" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="PasswordBox" Height="40" Padding="12,8" FontSize="14" Background="#27272A" Foreground="#FAFAFA" BorderBrush="#3F3F46"
                                 InputMethod.IsInputMethodEnabled="False"/>
                </StackPanel>

                <!-- Error Message -->
                <TextBlock x:Name="ErrorText" Foreground="#F87171" FontSize="12" TextWrapping="Wrap"
                           Margin="0,0,0,10" Visibility="Collapsed" HorizontalAlignment="Center"/>

                <!-- Login Button -->
                <Button x:Name="LoginButton" Height="42" Click="LoginButton_Click"
                        Style="{StaticResource ModernButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ButtonIcon" Text="" Margin="0,0,8,0"/>
                        <TextBlock x:Name="ButtonText" Text="Sign In"/>
                    </StackPanel>
                </Button>

                <!-- Loading Indicator -->
                <StackPanel x:Name="LoadingPanel" Orientation="Horizontal" HorizontalAlignment="Center" 
                            Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBlock Text="⏳" FontSize="14" Margin="0,0,8,0" Foreground="#22D3EE"/>
                    <TextBlock x:Name="LoadingText" Text="Signing in..." Foreground="#71717A" FontSize="13"/>
                </StackPanel>

                <!-- Toggle to Signup -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                    <TextBlock x:Name="TogglePrompt" Text="Don't have an account? " Foreground="#71717A" FontSize="13"/>
                    <TextBlock x:Name="ToggleLink" Text="Sign Up" Foreground="#22D3EE" FontWeight="SemiBold" 
                               FontSize="13" Cursor="Hand" MouseDown="ToggleMode_Click">
                        <TextBlock.TextDecorations>
                            <TextDecoration Location="Underline"/>
                        </TextBlock.TextDecorations>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
