<Window x:Class="TallySyncApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TallyLink - Login" Height="550" Width="420"
        Icon="pack://application:,,,/tallylink_logo.png"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Background="#2563EB">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Logo Area -->
        <StackPanel Margin="40,40,40,20" HorizontalAlignment="Center">
            <Border Width="70" Height="70" Background="White" CornerRadius="18">
                <Image Source="pack://application:,,,/tallylink_logo.png" Margin="10" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <TextBlock Text="TallySync" Foreground="White" FontSize="24" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,15,0,0"/>
            <TextBlock Text="Tally Cloud Sync Desktop App" Foreground="#93C5FD" FontSize="12" 
                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Login Card -->
        <Border Grid.Row="1" Background="White" CornerRadius="24,24,0,0" Padding="35,30">
            <StackPanel>
                <!-- Toggle: Login / Signup -->
                <TextBlock x:Name="HeaderText" Text="Welcome Back" FontSize="22" FontWeight="Bold" 
                           Foreground="#1F2937" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock x:Name="SubHeaderText" Text="Sign in to your account" Foreground="#6B7280" 
                           FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                <!-- Full Name (only for signup) -->
                <StackPanel x:Name="FullNamePanel" Visibility="Collapsed" Margin="0,0,0,15">
                    <TextBlock Text="Full Name" Foreground="#374151" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="FullNameBox" Height="42" Padding="12,10" FontSize="14"
                             BorderBrush="#D1D5DB" BorderThickness="1">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </StackPanel>

                <!-- Email -->
                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Email" Foreground="#374151" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="EmailBox" Height="42" Padding="12,10" FontSize="14"
                             BorderBrush="#D1D5DB" BorderThickness="1">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </StackPanel>

                <!-- Password -->
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="Password" Foreground="#374151" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="PasswordBox" Height="42" Padding="12,10" FontSize="14"
                                 BorderBrush="#D1D5DB" BorderThickness="1">
                        <PasswordBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </PasswordBox.Resources>
                    </PasswordBox>
                </StackPanel>

                <!-- Error Message -->
                <TextBlock x:Name="ErrorText" Foreground="#EF4444" FontSize="12" TextWrapping="Wrap"
                           Margin="0,0,0,10" Visibility="Collapsed"/>

                <!-- Login Button -->
                <Button x:Name="LoginButton" Height="45" Click="LoginButton_Click"
                        Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="14"
                        BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ButtonIcon" Text="" Margin="0,0,8,0"/>
                        <TextBlock x:Name="ButtonText" Text="Sign In"/>
                    </StackPanel>
                </Button>

                <!-- Loading Indicator -->
                <StackPanel x:Name="LoadingPanel" Orientation="Horizontal" HorizontalAlignment="Center" 
                            Margin="0,15,0,0" Visibility="Collapsed">
                    <TextBlock Text="⏳" FontSize="14" Margin="0,0,8,0"/>
                    <TextBlock x:Name="LoadingText" Text="Signing in..." Foreground="#6B7280" FontSize="13"/>
                </StackPanel>

                <!-- Toggle to Signup -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <TextBlock x:Name="TogglePrompt" Text="Don't have an account? " Foreground="#6B7280" FontSize="13"/>
                    <TextBlock x:Name="ToggleLink" Text="Sign Up" Foreground="#2563EB" FontWeight="SemiBold" 
                               FontSize="13" Cursor="Hand" MouseDown="ToggleMode_Click">
                        <TextBlock.TextDecorations>
                            <TextDecoration Location="Underline"/>
                        </TextBlock.TextDecorations>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
