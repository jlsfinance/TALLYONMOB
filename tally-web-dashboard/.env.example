# Application
# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# JLS Bill API (Optional)
# JLS_API_BASE_URL is used by the Vercel function and VITE_JLS_API_BASE_URL is kept for Vite dev proxy compatibility.
JLS_API_BASE_URL=https://your-jls-api-host
VITE_JLS_API_BASE_URL=https://your-jls-api-host

# Tally Middleware (Optional)
# For browser-only Vite dev or a LAN desktop bridge, set VITE_TALLY_MIDDLEWARE_URL to a reachable endpoint returning /api/tally/sync-compatible JSON.
# When empty, the local Tally API dev plugin is used instead.
VITE_TALLY_MIDDLEWARE_URL=

# Admin Console
VITE_ENABLE_ADMIN_CONSOLE=false
VITE_ADMIN_EMAILS=admin@example.com

# Backend URL
VITE_BACKEND_URL=http://localhost:5000

# Razorpay (Optional)
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id_here

# Support
VITE_SUPPORT_EMAIL=lovneetrathi@gmail.com
VITE_SUPPORT_PHONE=+91 9413821007
