{
    "rewrites": [
        {
            "source": "/api/v1/subscriptions/:path*",
            "destination": "/api/subscription?route=:path*"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
