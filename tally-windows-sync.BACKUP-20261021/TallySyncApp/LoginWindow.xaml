<Window x:Class="TallySyncApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TallySync - Login" Height="620" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Background="#F7F8FA">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Logo Area -->
        <StackPanel Margin="40,35,40,20" HorizontalAlignment="Center">
            <!-- Brand Icon -->
            <Border Width="56" Height="56" Background="#1A56DB" CornerRadius="14">
                <TextBlock Text="⚡" FontSize="26" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="White"/>
            </Border>
            <TextBlock Text="TallySync" Foreground="#1F2937" FontSize="24" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,15,0,0"/>
            <TextBlock Text="Desktop Connector" Foreground="#6B7280" FontSize="13" 
                       HorizontalAlignment="Center" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Login Card -->
        <Border Grid.Row="1" Background="White" CornerRadius="20,20,0,0" 
                Padding="35,28" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="-2" Direction="90" 
                                  Color="#000000" Opacity="0.04"/>
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="HeaderText" Text="Welcome Back" FontSize="22" FontWeight="Bold" 
                               Foreground="#1F2937" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock x:Name="SubHeaderText" Text="Sign in to your account" Foreground="#6B7280" 
                               FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                    <!-- Full Name (Signup only) -->
                    <StackPanel x:Name="FullNamePanel" Visibility="Collapsed" Margin="0,0,0,14">
                        <TextBlock Text="Full Name" Foreground="#374151" FontWeight="Medium" 
                                   FontSize="13" Margin="0,0,0,6"/>
                        <TextBox x:Name="FullNameBox" Height="44" Padding="14,0" 
                                 VerticalContentAlignment="Center" FontSize="14"
                                 BorderBrush="#D1D5DB" BorderThickness="1"
                                 Background="#F9FAFB">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>

                    <!-- Email -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Email" Foreground="#374151" FontWeight="Medium" 
                                   FontSize="13" Margin="0,0,0,6"/>
                        <TextBox x:Name="EmailBox" Height="44" Padding="14,0" 
                                 VerticalContentAlignment="Center" FontSize="14"
                                 BorderBrush="#D1D5DB" BorderThickness="1"
                                 Background="#F9FAFB">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>

                    <!-- Password -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Password" Foreground="#374151" FontWeight="Medium" 
                                   FontSize="13" Margin="0,0,0,6"/>
                        <PasswordBox x:Name="PasswordBox" Height="44" Padding="14,0" 
                                     VerticalContentAlignment="Center" FontSize="14"
                                     BorderBrush="#D1D5DB" BorderThickness="1"
                                     Background="#F9FAFB">
                            <PasswordBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </PasswordBox.Resources>
                        </PasswordBox>
                    </StackPanel>

                    <!-- Error Message -->
                    <Border x:Name="ErrorBorder" Background="#FEF2F2" BorderBrush="#FECACA" 
                            BorderThickness="1" CornerRadius="8" Padding="12,10" 
                            Margin="0,0,0,14" Visibility="Collapsed">
                        <TextBlock x:Name="ErrorText" Foreground="#DC2626" FontSize="12" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Login Button — Trust Blue -->
                    <Border CornerRadius="8" Background="#1A56DB" Margin="0,0,0,12">
                        <Button x:Name="LoginButton" Height="46" Click="LoginButton_Click"
                                Background="Transparent" Foreground="White" FontWeight="SemiBold" FontSize="14"
                                BorderThickness="0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ButtonIcon" Text="" Margin="0,0,8,0"/>
                                <TextBlock x:Name="ButtonText" Text="Sign In"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- Divider -->
                    <Grid Margin="0,4,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Height="1" Background="#E5E7EB" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="or" Foreground="#9CA3AF" FontSize="12" 
                                   Margin="12,0" VerticalAlignment="Center"/>
                        <Border Grid.Column="2" Height="1" Background="#E5E7EB" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Google Sign-In Button -->
                    <Border CornerRadius="8" Background="White" BorderBrush="#D1D5DB" 
                            BorderThickness="1" Margin="0,0,0,14">
                        <Button x:Name="GoogleSignInButton" Height="46" Click="GoogleSignInButton_Click"
                                Background="Transparent" Foreground="#374151" FontWeight="SemiBold" FontSize="14"
                                BorderThickness="0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="G" FontWeight="Bold" Foreground="#4285F4" FontSize="16"
                                           Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Continue with Google" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- Loading Indicator -->
                    <StackPanel x:Name="LoadingPanel" Orientation="Horizontal" HorizontalAlignment="Center" 
                                Margin="0,0,0,12" Visibility="Collapsed">
                        <TextBlock x:Name="LoadingText" Text="Signing in..." Foreground="#6B7280" FontSize="13"/>
                    </StackPanel>

                    <!-- Toggle to Signup -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <TextBlock x:Name="TogglePrompt" Text="Don't have an account? " 
                                   Foreground="#6B7280" FontSize="13"/>
                        <TextBlock x:Name="ToggleLink" Text="Sign Up" Foreground="#1A56DB" FontWeight="SemiBold" 
                                   FontSize="13" Cursor="Hand" MouseDown="ToggleMode_Click">
                            <TextBlock.TextDecorations>
                                <TextDecoration Location="Underline"/>
                            </TextBlock.TextDecorations>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
