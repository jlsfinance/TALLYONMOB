<Window x:Class="TallySyncApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TallyLink - Login" Height="600" Width="440"
        Icon="app_icon.ico"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <!-- Floating animation for logo -->
        <Storyboard x:Key="FloatingAnimation" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="0" To="-8" Duration="0:0:2.5"
                             EasingFunction="SineEase"/>
        </Storyboard>

        <!-- Spinner rotation -->
        <Storyboard x:Key="SpinnerAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="0" To="360" Duration="0:0:1.2"
                             EasingFunction="LinearEase"/>
        </Storyboard>
    </Window.Resources>

    <!-- Main container with gradient background + glass overlay -->
    <Grid>
        <!-- Outer gradient background with rounded window -->
        <Border CornerRadius="16"
                Background="#2563EB"
                BorderThickness="0">
            <Border.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#2563EB" Offset="0.0"/>
                    <GradientStop Color="#1D4ED8" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.OpacityMask>
        </Border>

        <!-- Subtle pattern overlay -->
        <Border CornerRadius="16" Background="Transparent" Opacity="0.03">
            <Border.Background>
                <DrawingBrush Viewport="0,0,40,40" ViewportUnits="Absolute" TileMode="Tile">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing Geometry="M0,20 L20,0" Pen="#FFFFFF" StrokeThickness="0.5"/>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Border.Background>
        </Border>

        <!-- Glass inner shadow border -->
        <Border CornerRadius="16" Background="Transparent">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="6" Color="#000000" Opacity="0.25"/>
            </Border.Effect>
        </Border>

        <Grid Margin="0,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== LOGO AREA ===== -->
            <StackPanel Margin="0,36,0,10" HorizontalAlignment="Center">
                <!-- Logo icon with floating animation -->
                <Border Width="80" Height="80"
                        Background="#FFFFFF"
                        CornerRadius="20"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TranslateTransform/>
                    </Border.RenderTransform>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Border.Loaded">
                            <BeginStoryboard Storyboard="{StaticResource FloatingAnimation}"/>
                        </EventTrigger>
                    </Border.Triggers>
                    <Grid>
                        <TextBlock Text="⟳" FontSize="38"
                                   Foreground="#2563EB"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"/>
                    </Grid>
                </Border>

                <TextBlock Text="TallySync" Foreground="White" FontSize="26"
                           FontWeight="Bold" HorizontalAlignment="Center" Margin="0,14,0,0"
                           LetterSpacing="1"/>
                <TextBlock Text="Cloud Sync Desktop App"
                           Foreground="#93C5FD" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,5,0,0"
                           LetterSpacing="0.5"/>
            </StackPanel>

            <!-- ===== LOGIN CARD (Glassmorphism) ===== -->
            <Border Grid.Row="1"
                    Background="#FFFFFF"
                    CornerRadius="16"
                    Margin="30,0,30,30"
                    Padding="32,28"
                    Effect="{StaticResource CardShadow}">

                <StackPanel>
                    <!-- Header -->
                    <TextBlock x:Name="HeaderText"
                               Text="Welcome Back"
                               FontSize="22" FontWeight="Bold"
                               Foreground="#1F2937"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="SubHeaderText"
                               Text="Sign in to your account"
                               Foreground="#6B7280"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,24"/>

                    <!-- Full Name (signup only) -->
                    <StackPanel x:Name="FullNamePanel" Visibility="Collapsed" Margin="0,0,0,16">
                        <TextBlock Text="Full Name"
                                   Foreground="#374151"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Margin="0,0,0,6"/>
                        <TextBox x:Name="FullNameBox"
                                 Style="{StaticResource ModernTextBox}"
                                 PlaceholderText="John Doe"/>
                    </StackPanel>

                    <!-- Email -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Email Address"
                                   Foreground="#374151"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Margin="0,0,0,6"/>
                        <TextBox x:Name="EmailBox"
                                 Style="{StaticResource ModernTextBox}"
                                 PlaceholderText="you@example.com"/>
                    </StackPanel>

                    <!-- Password -->
                    <StackPanel Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Password"
                                       Foreground="#374151"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Margin="0,0,0,6"/>
                        </Grid>
                        <PasswordBox x:Name="PasswordBox"
                                     Style="{StaticResource ModernPasswordBox}"/>
                    </StackPanel>

                    <!-- Error Message -->
                    <Border x:Name="ErrorBorder"
                            Background="#FEF2F2"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="0,0,0,14"
                            Visibility="Collapsed"
                            BorderBrush="#FECACA"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠" FontSize="13" Margin="0,0,8,0" Foreground="#EF4444"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="ErrorText"
                                       Foreground="#DC2626" FontSize="12"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Login Button -->
                    <Button x:Name="LoginButton"
                            Click="LoginButton_Click"
                            Height="46"
                            Style="{StaticResource ModernButton}"
                            FontSize="15">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ButtonIcon" Text="" Margin="0,0,8,0"/>
                            <TextBlock x:Name="ButtonText" Text="Sign In"/>
                        </StackPanel>
                    </Button>

                    <!-- Loading Spinner -->
                    <StackPanel x:Name="LoadingPanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,16,0,0"
                                Visibility="Collapsed">
                        <Border Width="18" Height="18"
                                Background="Transparent"
                                RenderTransformOrigin="0.5,0.5"
                                Margin="0,0,10,0">
                            <Border.RenderTransform>
                                <RotateTransform/>
                            </Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Border.Loaded">
                                    <BeginStoryboard Storyboard="{StaticResource SpinnerAnimation}"/>
                                </EventTrigger>
                            </Border.Triggers>
                            <Grid>
                                <Ellipse Width="18" Height="18"
                                         Stroke="#E5E7EB" StrokeThickness="2.5"/>
                                <Ellipse Width="18" Height="18"
                                         Stroke="#2563EB" StrokeThickness="2.5"
                                         StrokeDashArray="25,50"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform Angle="-90"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="LoadingText"
                                   Text="Signing in..."
                                   Foreground="#6B7280" FontSize="13"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Toggle Login/Signup -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,18,0,0">
                        <TextBlock x:Name="TogglePrompt"
                                   Text="Don't have an account? "
                                   Foreground="#6B7280" FontSize="13"/>
                        <TextBlock x:Name="ToggleLink"
                                   Text="Sign Up"
                                   Foreground="#2563EB" FontWeight="SemiBold"
                                   FontSize="13" Cursor="Hand"
                                   MouseDown="ToggleMode_Click">
                            <TextBlock.TextDecorations>
                                <TextDecoration Location="Underline"/>
                            </TextBlock.TextDecorations>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
